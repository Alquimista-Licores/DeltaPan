		img: divisoraAlavancaImg,
		alt: 'Divisora de Coluna DeltaPan',
		whatsappMsg: 'Olá! Gostaria de solicitar um orçamento para o equipamento: Divisora de Coluna (Linha DC 30 Coluna).',
		description: 'Projetada com engenharia mecânica pesada montada sobre coluna estrutural em ferro fundido nodular. Possui alavanca lateral ergonômica com sistema multiplicador de força, cabeçote com navalhas radiais e anel de prensagem que proporciona corte uniforme e instantâneo até nas massas mais densas, com máxima durabilidade operacional.',
		differentials: [
			{ title: 'Corpo e Coluna em Ferro Fundido Maciço', desc: 'Extrema estabilidade operacional sem flexão ou vibrações' },
			{ title: 'Alavanca Lateral com Engrenamento', desc: 'Transmissão mecânica suave que reduz o esforço físico na prensagem' },
			{ title: 'Cabeçote Radial de Precisão', desc: 'Divisão exata em 30 pedaços calibrados com corte limpo das fibras' },
			{ title: 'Base Redonda com Pré-Furos', desc: 'Fixação firme e segura diretamente no piso ou bancada de trabalho' }
		],
		specs: [
			{ label: 'Número de Divisões', value: '30 pedaços calibrados' },
