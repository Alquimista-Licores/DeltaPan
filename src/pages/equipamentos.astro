		shortDesc: 'Precisão máxima para massas leves e cremes',
		category: 'Confeitaria & Panificação',
		img: batedeiraImg,
		alt: 'Batedeira Planetária Industrial DeltaPan',
		whatsappMsg: 'Olá! Gostaria de solicitar um orçamento para o equipamento: Batedeira Planetária (Linha BP 20 / BP 40 Litros).',
