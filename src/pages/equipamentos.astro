		model: 'Linha DM 30 Mesa',
		shortDesc: 'Divisão uniforme de 30 porções com base de bancada',
		category: 'Divisão & Porcionamento',
		img: divisoraColunaImg,
		alt: 'Divisora de Mesa DeltaPan',
		whatsappMsg: 'Olá! Gostaria de solicitar um orçamento para o equipamento: Divisora de Mesa (Linha DM 30 Mesa).',
		description: 'Ideal para padarias e confeitarias que buscam alta produtividade com padronização rigorosa no peso das porções. Equipada com navalhas em aço inox de alta afiação e prato basculante que garante divisão exata em 30 porções iguais sem rasgar ou desgastar a estrutura da massa.',
		differentials: [
			{ title: 'Corte de 30 Divisões Iguais', desc: 'Conjunto de facas estampadas em aço inox com corte preciso e uniforme' },
			{ title: 'Estrutura Compacta de Mesa', desc: 'Perfeita para bancadas ou cavalete de suporte em padarias e confeitarias' },
			{ title: 'Prato Basculante Sanitário', desc: 'Alumínio naval de alta resistência com acabamento polido antiaderente' },
