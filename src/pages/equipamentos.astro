---

<Layout>
	<!-- Header Flutuante Reutilizável -->
	<Header currentPage="equipamentos" />

	<main class="equipamentos-main">
		
		<!-- Dobra 1: Apresentação dos Equipamentos (Existente mantida intacta) -->
		<EquipamentosShowcase machines={machines} />

		<!-- Dobra 2: Nova Linha de Equipamentos (Modeladora e Divisoras) -->
		<EquipamentosShowcase machines={machinesBatch2} />

	</main>

	<!-- Modal Interativo com Suporte a Todos os Equipamentos -->
	<ProductModal machines={[...machines, ...machinesBatch2]} />

	<!-- Footer Reutilizável -->
	<Footer />
</Layout>

<style>
	/* ========================================================================= */
	/* 1. LAYOUT PRINCIPAL                                                       */
	/* ========================================================================= */
	.equipamentos-main {
		width: 100%;
		padding-top: 5.5rem;
		padding-bottom: 4rem;
		background: #f8fafc;
		min-height: calc(100vh - 100px);
		transition: filter 0.35s ease;
	}

	/* Desfoque do fundo da página quando o modal estiver aberto */
	:global(body.modal-open .equipamentos-main),
	:global(body.modal-open #main-header),
	:global(body.modal-open footer) {
		filter: blur(8px);
		transition: filter 0.35s ease;
		pointer-events: none;
		user-select: none;
	}

	:global(body.modal-open) {
		overflow: hidden;
	}
</style>
