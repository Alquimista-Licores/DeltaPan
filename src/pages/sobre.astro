---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import factoryImg from '../assets/sobre-fabrica.jpg';

const valuesList = [
	{
		title: 'Qualidade e Robustez',
		desc: 'Na Delta Pan, cada equipamento é desenvolvido e fabricado com foco na qualidade, resistência e durabilidade. Utilizamos materiais e componentes de qualidade, aliados à experiência de mais de 30 anos no setor, para oferecer máquinas robustas, confiáveis e preparadas para atender às exigências da produção diária, reduzindo a necessidade de manutenção e proporcionando segurança e tranquilidade aos nossos clientes.'
	},
	{
		title: 'Segurança e Conformidade NR12',
		desc: 'Na Delta Pan, a segurança é prioridade em todas as etapas de desenvolvimento e fabricação dos nossos equipamentos. Cada máquina é projetada e fabricada conforme os requisitos da Norma Regulamentadora NR12, incorporando sistemas de proteção e dispositivos de segurança, sempre pensando em proporcionar segurança ao operador.<br /><br />Aliamos tecnologia, qualidade construtiva e responsabilidade para oferecer equipamentos seguros.'
	}
];
---

<Layout>
	<!-- Header Flutuante Global -->
	<Header currentPage="sobre" />

	<main class="sobre-main">
		
		<!-- ========================================================================= -->
		<!-- HISTÓRIA E ENGENHARIA FABRIL                                              -->
		<!-- ========================================================================= -->
		<section class="history-section">
			<div class="history-wrapper">

				<div class="history-header">
					<h1 class="history-title">
						Tradição, tecnologia e qualidade na fabricação de equipamentos para panificação.
					</h1>
				</div>

				<div class="history-container">
					
					<div class="history-text-col">
						<p class="section-p">
							Localizada em Criciúma, Santa Catarina, a Delta Pan Equipamentos é uma indústria brasileira especializada no desenvolvimento e fabricação de máquinas para o setor de panificação.
						</p>
						<p class="section-p">
							Com mais de 30 anos de experiência no setor, reunimos conhecimento técnico, tecnologia e compromisso com a qualidade para desenvolver equipamentos industriais de elevada robustez, confiabilidade e desempenho.
						</p>
						<p class="section-p">
							Nossos equipamentos são projetados para atender às exigências de aplicações profissionais e industriais, priorizando segurança operacional, durabilidade, produtividade e facilidade de manutenção.
						</p>
						<p class="section-p">
							Valorizamos a fabricação nacional, a qualidade dos materiais e a eficiência dos processos, oferecendo aos nossos clientes facilidade na reposição de peças, assistência técnica e suporte especializado.
						</p>
						<p class="section-p">
							Estamos em constante evolução, aperfeiçoando nossos equipamentos e desenvolvendo novas soluções para acompanhar as necessidades e os desafios do mercado.
						</p>
					</div>

					<div class="history-media-col">
						<div class="media-card-wrapper" id="media-parallax-wrapper">
							<img 
								src={factoryImg.src} 
								alt="Parque fabril de usinagem e fabricação de equipamentos DeltaPan" 
								class="media-main-img" 
								id="media-parallax-img" 
								loading="lazy"
							/>
						</div>
						<div class="media-floating-badge">
							<span class="badge-title">Força, tecnologia e confiança para sua produção</span>
						</div>
					</div>

				</div>

			</div>
		</section>

		<!-- ========================================================================= -->
		<!-- 3. MISSÃO, VISÃO E VALORES                                                -->
		<!-- ========================================================================= -->
		<section class="mvv-section">
			<div class="mvv-container">
				
				<div class="section-header-center">
					<h2 class="section-title center">Nossos Princípios e Propósito</h2>
					<p class="section-subtitle center">
						A filosofia de engenharia e relacionamento que orienta cada máquina entregue pela DeltaPan.
					</p>
				</div>

				<div class="mvv-grid">
					
					<!-- Card 1: MISSÃO -->
					<div class="mvv-card">
						<div class="mvv-icon-wrap icon-mission">
							<svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
								<circle cx="12" cy="12" r="10"></circle>
								<circle cx="12" cy="12" r="6"></circle>
								<circle cx="12" cy="12" r="2"></circle>
							</svg>
						</div>
						<span class="mvv-kicker">PROPÓSITO</span>
						<h3 class="mvv-card-title">Missão</h3>
						<p class="mvv-card-desc">
							Desenvolver e fabricar equipamentos para panificação com qualidade, robustez e segurança, proporcionando aos nossos clientes produtividade, confiabilidade e durabilidade, com assistência técnica e suporte especializado.
						</p>
					</div>

					<!-- Card 2: VISÃO -->
					<div class="mvv-card">
						<div class="mvv-icon-wrap icon-vision">
							<svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
								<path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"></path>
								<circle cx="12" cy="12" r="3"></circle>
							</svg>
						</div>
						<span class="mvv-kicker">FUTURO</span>
						<h3 class="mvv-card-title">Visão</h3>
						<p class="mvv-card-desc">
							Ser reconhecida como referência em qualidade na fabricação de equipamentos para panificação, destacando-se pela robustez, durabilidade e confiabilidade de nossos produtos, conquistando a confiança e a satisfação de nossos clientes.
						</p>
					</div>

					<!-- Card 3: VALORES -->
					<div class="mvv-card">
						<div class="mvv-icon-wrap icon-values">
							<svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
								<path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path>
							</svg>
						</div>
						<span class="mvv-kicker">CONDUTA</span>
						<h3 class="mvv-card-title">Valores</h3>
						<p class="mvv-card-desc">
							Na Delta Pan Equipamentos, acreditamos que a confiança se conquista com honestidade, respeito e compromisso.<br /><br />
							Valorizamos a qualidade em tudo o que fazemos, a transparência nas relações com nossos clientes, a responsabilidade em cumprir o que prometemos e a dedicação em oferecer equipamentos confiáveis, seguros e duráveis.
						</p>
					</div>

				</div>

			</div>
		</section>

		<!-- ========================================================================= -->
		<!-- 4. PILARES DE FABRICAÇÃO E ENGENHARIA                                      -->
		<!-- ========================================================================= -->
		<section class="pillars-section">
			<div class="pillars-container">
				
				<div class="pillars-header">
					<h2 class="section-title center">
						Pilares Construtivos da Delta Pan
					</h2>
				</div>

				<div class="pillars-grid">
					{valuesList.map((item, idx) => (
						<div class="pillar-card">
							<div class="pillar-number">0{idx + 1}</div>
							<h4 class="pillar-title">{item.title}</h4>
							<p class="pillar-desc" set:html={item.desc}></p>
						</div>
					))}
				</div>

			</div>
		</section>



	</main>

	<!-- Footer Global Reutilizável -->
	<Footer />
</Layout>

<script>
	document.addEventListener('DOMContentLoaded', () => {
		const parallaxWrapper = document.getElementById('media-parallax-wrapper');
		const parallaxImg = document.getElementById('media-parallax-img');

		if (parallaxWrapper && parallaxImg) {
			let ticking = false;

			function updateParallax() {
				const rect = parallaxWrapper.getBoundingClientRect();
				const winHeight = window.innerHeight;

				if (rect.top < winHeight && rect.bottom > 0) {
					// Progresso de entrada e saída (0 a 1)
					const progress = (winHeight - rect.top) / (winHeight + rect.height);
					// Ao descer a página, a imagem sobe internamente na moldura
					const translateY = (0.5 - progress) * 110;
					parallaxImg.style.transform = `translate3d(0, ${translateY.toFixed(2)}px, 0) scale(1.15)`;
				}
				ticking = false;
			}

			window.addEventListener('scroll', () => {
				if (!ticking) {
					window.requestAnimationFrame(updateParallax);
					ticking = true;
				}
			}, { passive: true });

			updateParallax();
		}
	});
</script>

<style>
	/* ========================================================================= */
	/* 1. LAYOUT PRINCIPAL                                                       */
	/* ========================================================================= */
	.sobre-main {
		width: 100%;
		padding-top: 5.5rem;
		background: #f8fafc;
		min-height: 100vh;
	}



	/* ========================================================================= */
	/* 3. SEÇÃO HISTÓRIA & LOCALIZAÇÃO (CRICIÚMA/SC)                             */
	/* ========================================================================= */
	.history-section {
		width: 100%;
		padding: 5rem 1.5rem;
		background: #ffffff;
		border-top: 1px solid #e2e8f0;
		border-bottom: 1px solid #e2e8f0;
		overflow-x: clip;
	}

	.history-wrapper {
		width: 100%;
		max-width: 1240px;
		margin: 0 auto;
	}

	.history-header {
		max-width: 960px;
		margin: 0 auto 3.5rem auto;
		text-align: center;
	}

	.history-title {
		font-family: 'Inter', -apple-system, BlinkMacSystemFont, sans-serif;
		font-size: clamp(1.85rem, 3.2vw, 2.75rem);
		font-weight: 800;
		color: #0f172a;
		letter-spacing: -0.03em;
		line-height: 1.25;
		margin: 0;
	}

	.history-container {
		width: 100%;
		display: grid;
		grid-template-columns: 1.15fr 0.85fr;
		gap: 4rem;
		align-items: center;
	}

	.section-tag {
		display: inline-flex;
		align-items: center;
		font-family: 'Inter', monospace;
		font-size: 0.72rem;
		font-weight: 700;
		letter-spacing: 0.15em;
		text-transform: uppercase;
		color: #64748b;
		background: #f1f5f9;
		padding: 0.35rem 0.85rem;
		border-radius: 6px;
		margin-bottom: 1.25rem;
	}

	.section-tag.center {
		margin-left: auto;
		margin-right: auto;
	}

	.section-title {
		font-family: 'Inter', sans-serif;
		font-size: clamp(1.65rem, 2.6vw, 2.35rem);
		font-weight: 800;
		color: #0f172a;
		letter-spacing: -0.025em;
		line-height: 1.25;
		margin-bottom: 1.5rem;
	}

	.section-title.center {
		text-align: center;
	}

	.section-subtitle.center {
		text-align: center;
		font-size: 1rem;
		color: #64748b;
		max-width: 620px;
		margin: 0 auto 3rem auto;
		line-height: 1.6;
	}

	.section-p {
		font-size: 0.95rem;
		color: #475569;
		line-height: 1.7;
		margin-bottom: 1.25rem;
	}

	.section-p:last-child {
		margin-bottom: 0;
	}

	.section-p strong {
		color: #0f172a;
	}

	.history-media-col {
		position: relative;
		width: 100%;
		display: flex;
		flex-direction: column;
	}

	.media-card-wrapper {
		position: relative;
		border-radius: 16px;
		overflow: hidden;
		box-shadow: 0 20px 40px -10px rgba(15, 23, 42, 0.16);
		height: 380px;
		min-height: 380px;
		max-height: 380px;
		display: flex;
		align-items: center;
		justify-content: center;
	}

	.media-main-img {
		width: 100%;
		height: 125%;
		min-height: 480px;
		object-fit: cover;
		display: block;
		will-change: transform;
		transform: translate3d(0, 0px, 0) scale(1.15);
		transition: filter 0.3s ease;
	}

	.media-floating-badge {
		position: absolute;
		bottom: 1.5rem;
		left: 1.25rem;
		right: -1.25rem;
		background: rgba(13, 31, 71, 0.94);
		backdrop-filter: blur(14px);
		-webkit-backdrop-filter: blur(14px);
		padding: 1rem 1.4rem;
		border-radius: 12px;
		border: 1px solid rgba(255, 255, 255, 0.2);
		box-shadow: 0 16px 36px -6px rgba(13, 31, 71, 0.4), 0 4px 12px rgba(0, 0, 0, 0.12);
		color: #ffffff;
		display: flex;
		flex-direction: column;
		z-index: 10;
		transition: transform 0.3s ease, box-shadow 0.3s ease;
	}

	.history-media-col:hover .media-floating-badge {
		transform: translateY(-2px);
		box-shadow: 0 24px 48px -6px rgba(13, 31, 71, 0.48);
	}

	.badge-title {
		font-size: 1rem;
		font-weight: 700;
		letter-spacing: -0.015em;
		line-height: 1.45;
		color: #ffffff;
	}

	/* ========================================================================= */
	/* 4. MISSÃO, VISÃO E VALORES                                                */
	/* ========================================================================= */
	.mvv-section {
		width: 100%;
		padding: 5.5rem 1.5rem;
		background: #f8fafc;
	}

	.mvv-container {
		width: 100%;
		max-width: 1240px;
		margin: 0 auto;
	}

	.section-header-center {
		text-align: center;
		margin-bottom: 3.5rem;
	}

	.mvv-grid {
		display: grid;
		grid-template-columns: 1fr 1fr 1fr;
		gap: 2rem;
	}

	@property --border-angle {
		syntax: "<angle>";
		inherits: true;
		initial-value: 0deg;
	}

	@keyframes rotateBorderAngle {
		0% {
			--border-angle: 0deg;
		}
		100% {
			--border-angle: 360deg;
		}
	}

	.mvv-card {
		position: relative;
		border-radius: 18px;
		background: #ffffff;
		padding: 2.25rem 1.75rem;
		display: flex;
		flex-direction: column;
		align-items: flex-start;
		box-shadow: 0 10px 30px -8px rgba(15, 23, 42, 0.05);
		transition: 
			transform 0.35s cubic-bezier(0.16, 1, 0.3, 1), 
			box-shadow 0.35s cubic-bezier(0.16, 1, 0.3, 1);
	}

	.mvv-card::before {
		content: '';
		position: absolute;
		inset: -1.5px;
		border-radius: 19.5px;
		--border-angle: 0deg;
		background: conic-gradient(from var(--border-angle), #090981 0%, #9f0101 50%, #090981 100%);
		pointer-events: none;
		z-index: 0;
		transition: 
			inset 0.35s cubic-bezier(0.16, 1, 0.3, 1),
			border-radius 0.35s cubic-bezier(0.16, 1, 0.3, 1);
		animation: rotateBorderAngle 6s linear infinite;
	}

	.mvv-card::after {
		content: '';
		position: absolute;
		inset: 0;
		border-radius: 18px;
		background: #ffffff;
		pointer-events: none;
		z-index: 1;
	}

	.mvv-card:hover {
		transform: translateY(-5px);
		box-shadow: 0 18px 40px -10px rgba(15, 23, 42, 0.12);
	}

	.mvv-card:hover::before {
		inset: -2px;
		border-radius: 20px;
	}

	.mvv-card > * {
		position: relative;
		z-index: 2;
	}

	.mvv-icon-wrap {
		width: 54px;
		height: 54px;
		border-radius: 12px;
		display: flex;
		align-items: center;
		justify-content: center;
		margin-bottom: 1.5rem;
	}

	.icon-mission {
		background: rgba(225, 29, 72, 0.1);
		color: #e11d48;
	}

	.icon-vision {
		background: rgba(13, 31, 71, 0.08);
		color: #0D1F47;
	}

	.icon-values {
		background: rgba(30, 41, 59, 0.08);
		color: #1e293b;
	}

	.mvv-kicker {
		font-family: 'Inter', monospace;
		font-size: 0.6875rem;
		font-weight: 700;
		letter-spacing: 0.15em;
		color: #94a3b8;
		text-transform: uppercase;
		margin-bottom: 0.4rem;
	}

	.mvv-card-title {
		font-family: 'Inter', sans-serif;
		font-size: 1.5rem;
		font-weight: 700;
		color: #0f172a;
		letter-spacing: -0.02em;
		margin-bottom: 0.85rem;
	}

	.mvv-card-desc {
		font-size: 0.93rem;
		color: #475569;
		line-height: 1.65;
	}

	/* ========================================================================= */
	/* 5. PILARES DE FABRICAÇÃO                                                  */
	/* ========================================================================= */
	.pillars-section {
		width: 100%;
		padding: 5rem 1.5rem;
		background: #ffffff;
		border-top: 1px solid #e2e8f0;
	}

	.pillars-container {
		width: 100%;
		max-width: 1240px;
		margin: 0 auto;
	}

	.pillars-header {
		max-width: 780px;
		margin: 0 auto 3.5rem auto;
		text-align: center;
	}

	.pillars-grid {
		display: grid;
		grid-template-columns: repeat(2, 1fr);
		gap: 2rem;
	}

	.pillar-card {
		background: #f8fafc;
		border: 1px solid #e2e8f0;
		border-radius: 14px;
		padding: 2.25rem 2rem;
		display: flex;
		flex-direction: column;
		transition: all 0.25s ease;
	}

	.pillar-card:hover {
		background: #ffffff;
		border-color: #cbd5e1;
		transform: translateY(-3px);
		box-shadow: 0 10px 25px -6px rgba(15, 23, 42, 0.08);
	}

	.pillar-number {
		font-family: 'Montserrat', sans-serif;
		font-size: 1.25rem;
		font-weight: 800;
		color: #cbd5e1;
		margin-bottom: 1rem;
	}

	.pillar-title {
		font-family: 'Inter', sans-serif;
		font-size: 1.15rem;
		font-weight: 700;
		color: #0f172a;
		line-height: 1.35;
		margin-bottom: 0.85rem;
	}

	.pillar-desc {
		font-size: 0.95rem;
		color: #64748b;
		line-height: 1.65;
	}



	/* ========================================================================= */
	/* RESPONSIVIDADE MOBILE & TABLET                                            */
	/* ========================================================================= */
	@media (max-width: 992px) {
		.history-container {
			grid-template-columns: 1fr;
			gap: 3rem;
		}

		.media-card-wrapper {
			min-height: 280px;
			height: 280px;
			max-height: 280px;
		}

		.media-main-img {
			height: 135%;
			min-height: 380px;
		}

		.media-floating-badge {
			left: 1rem;
			right: -0.75rem;
			bottom: 1rem;
			padding: 0.85rem 1.15rem;
		}

		.mvv-grid {
			grid-template-columns: 1fr;
			gap: 1.5rem;
		}

		.mvv-card {
			align-items: center;
			text-align: center;
		}

		.mvv-icon-wrap {
			margin-left: auto;
			margin-right: auto;
		}

		.mvv-card-desc {
			text-align: center;
		}

		.pillars-grid {
			grid-template-columns: 1fr 1fr;
		}
	}

	@media (max-width: 640px) {
		.media-floating-badge {
			right: 0.5rem;
			left: 0.5rem;
			width: auto;
			max-width: none;
		}

		.pillars-grid {
			grid-template-columns: 1fr;
		}
	}
</style>
