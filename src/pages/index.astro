---
import Layout from '../layouts/Layout.astro';
import HeaderHome from '../components/HeaderHome.astro';
import Footer from '../components/Footer.astro';
import logo from '../assets/logo.png';
import heroImg from '../assets/hero.jpg';
import amassadeiraImg from '../assets/amassadeira-espiral.png';
import divisoraImg from '../assets/divisora-de-mesa.png';
import modeladoraImg from '../assets/modeladora.jpg';
---

<Layout>
	<!-- Header Exclusivo da Página Inicial (Stuck no topo < 200px, Flutuante >= 200px) -->
	<HeaderHome currentPage="inicio" />

	<!-- ========================================================================= -->
	<!-- 1. HERO: FOTO ORIGINAL ALINHADA ÀS LATERAIS COM LOGO TRANSPARENTE         -->
	<!-- ========================================================================= -->
	<section id="inicio" class="hero-section">
		
		<!-- Imagem de Fundo Original com Parallax Leve (Edge-to-Edge) -->
		<div class="hero-image-container">
			<img 
				src={heroImg.src} 
				alt="Fábrica de Máquinas para Panificação DeltaPan" 
				class="hero-bg-image" 
			/>
		</div>

		<!-- Conteúdo Sobreposto no Lado Esquerdo -->
		<div class="hero-content-wrapper">
			<div class="hero-left-column">
				
				<!-- Logo na Hero (Transição discreta subindo para o header ao rolar) -->
				<div class="hero-logo-box" id="hero-logo">
					<img 
						src={logo.src} 
						alt="DeltaPan Máquinas para Panificação" 
						class="hero-overlaid-logo" 
						width="320" 
						height="80" 
					/>
				</div>

				<!-- Título Principal com Cor Escura e Alta Legibilidade -->
				<h1 class="hero-title">
					Equipamentos que fazem sua produção render mais
				</h1>

				<!-- Subtítulo -->
				<p class="hero-description">
					Máquinas profissionais para padarias, confeitarias <br class="desktop-br" />e indústrias que buscam mais produtividade, <br class="desktop-br" />padronização e eficiência na produção.
				</p>

			</div>
		</div>

	</section>

	<!-- ========================================================================= -->
	<!-- 2. SEGUNDA DOBRA: APRESENTAÇÃO DOS EQUIPAMENTOS                          -->
	<!-- ========================================================================= -->
	<section id="maquinas" class="equipments-section">
		<div class="equipments-container">
			
			<!-- Cabeçalho da Seção -->
			<div class="section-header">
				<h2 class="section-title">
					Equipamentos Projetados para Alta Produtividade
				</h2>
				<p class="section-subtitle">
					Do preparo da massa ao formato final: precisão, robustez e eficiência em cada detalhe.
				</p>
			</div>

			<!-- Grid dos 3 Equipamentos com Linha de Fundo Animada -->
			<div class="equipments-grid" id="equipments-flow-grid">
				
				<!-- Linha contínua ao fundo (da esquerda para a direita) -->
				<div class="equipments-bg-line" aria-hidden="true">
					<div class="bg-line-progress"></div>
				</div>

				<!-- Equipamento 1: Prepare a massa (Amassadeira) -->
				<div class="equipment-card card-step-1">
					<div class="card-image-box">
						<img 
							src={amassadeiraImg.src} 
							alt="Prepare a massa" 
							class="equipment-img" 
							loading="lazy" 
						/>
					</div>
					<div class="card-body">
						<div class="step-counter">Etapa 01</div>
						<h3 class="equipment-step-title">Prepare a massa</h3>
						<p class="equipment-desc">
							Desenvolvimento perfeito do glúten, homogeneização rápida e controle térmico
						</p>
					</div>
				</div>

				<!-- Equipamento 2: Divida (Divisora) -->
				<div class="equipment-card card-step-2">
					<div class="card-image-box">
						<img 
							src={divisoraImg.src} 
							alt="Divida" 
							class="equipment-img img-divisora-mesa" 
							loading="lazy" 
						/>
					</div>
					<div class="card-body">
						<div class="step-counter">Etapa 02</div>
						<h3 class="equipment-step-title">Divida</h3>
						<p class="equipment-desc">
							Divisão exata em porções iguais com rapidez e sem agredir a estrutura da massa.
						</p>
					</div>
				</div>

				<!-- Equipamento 3: Modele (Modeladora) -->
				<div class="equipment-card card-step-3">
					<div class="card-image-box">
						<img 
							src={modeladoraImg.src} 
							alt="Modele" 
							class="equipment-img" 
							loading="lazy" 
						/>
					</div>
					<div class="card-body">
						<div class="step-counter">Etapa 03</div>
						<h3 class="equipment-step-title">Modele</h3>
						<p class="equipment-desc">
							Enrolamento contínuo e uniforme com esteira de alta tração.
						</p>
					</div>
				</div>

			</div>

			<!-- Botão de Ação: Conhecer Todos os Equipamentos -->
			<div class="full-line-action-box">
				<a href="/equipamentos" class="btn-explore-products">
					<span>Conhecer Todos os Equipamentos</span>
					<svg class="icon-btn-arrow" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
						<line x1="5" y1="12" x2="19" y2="12"></line>
						<polyline points="12 5 19 12 12 19"></polyline>
					</svg>
				</a>
			</div>



		</div>
	</section>

	<!-- ========================================================================= -->
	<!-- 3. TERCEIRA DOBRA: INSTITUCIONAL (MISSÃO, VISÃO E VALORES) COM PARALLAX  -->
	<!-- ========================================================================= -->
	<section id="sobre" class="institutional-section">
		
		<!-- Elemento Decorativo com Parallax Leve de Fundo -->
		<div class="institutional-bg-grid parallax-layer" data-speed="0.08"></div>

		<div class="institutional-container">
			
			<!-- Cabeçalho da Seção -->
			<div class="section-header">
				<h2 class="section-title">
					Compromisso com o Sucesso da sua Panificação
				</h2>
				<p class="section-subtitle">
					Princípios sólidos, engenharia de ponta e relacionamentos de longo prazo.
				</p>
			</div>

			<!-- Grid dos 3 Cards (Missão, Visão, Valores) com Animação Desktop & Sticky Mobile -->
			<div class="institutional-grid" id="institutional-cards-grid">
				
				<!-- Card 1: MISSÃO -->
				<div class="institutional-card card-missao">
					<div class="inst-icon-box">
						<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
							<circle cx="12" cy="12" r="10"></circle>
							<circle cx="12" cy="12" r="6"></circle>
							<circle cx="12" cy="12" r="2"></circle>
						</svg>
					</div>
					<h3 class="inst-card-title">MISSÃO</h3>
					<p class="inst-card-text">
						Desenvolver e fabricar equipamentos para panificação com qualidade, robustez e segurança, proporcionando aos nossos clientes produtividade, confiabilidade e durabilidade, com assistência técnica e suporte especializado.
					</p>
				</div>

				<!-- Card 2: VISÃO -->
				<div class="institutional-card card-visao">
					<div class="inst-icon-box">
						<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
							<path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"></path>
							<circle cx="12" cy="12" r="3"></circle>
						</svg>
					</div>
					<h3 class="inst-card-title">VISÃO</h3>
					<p class="inst-card-text">
						Ser reconhecida como referência em qualidade na fabricação de equipamentos para panificação, destacando-se pela robustez, durabilidade e confiabilidade de nossos produtos, conquistando a confiança e a satisfação de nossos clientes.
					</p>
				</div>

				<!-- Card 3: VALORES -->
				<div class="institutional-card card-valores">
					<div class="inst-icon-box">
						<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
							<path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path>
						</svg>
					</div>
					<h3 class="inst-card-title">VALORES</h3>
					<p class="inst-card-text">
						Na Delta Pan Equipamentos, acreditamos que a confiança se conquista com honestidade, respeito e compromisso.<br /><br />
						Valorizamos a qualidade em tudo o que fazemos, a transparência nas relações com nossos clientes, a responsabilidade em cumprir o que prometemos e a dedicação em oferecer equipamentos confiáveis, seguros e duráveis.
					</p>
				</div>

			</div>



		</div>
	</section>

	<!-- Footer Global Reutilizável com telefones, e-mails e marca d'água aproximada -->
	<Footer />
</Layout>

<script>
	// Gerenciador de scroll: acoplamento do header, transição do logo e parallax leve
	document.addEventListener('DOMContentLoaded', () => {
		const header = document.getElementById('site-header');
		const heroLogo = document.getElementById('hero-logo');
		const heroBg = document.querySelector('.hero-bg-image');
		const parallaxCards = document.querySelectorAll('.parallax-card');
		const parallaxLayer = document.querySelector('.parallax-layer');

		// Animação sequencial da dobra de equipamentos (linha de fundo + surgimento ordenado)
		const equipmentsGrid = document.getElementById('equipments-flow-grid');
		if (equipmentsGrid) {
			const startAnimation = () => {
				equipmentsGrid.classList.add('is-animated');
			};

			if ('IntersectionObserver' in window) {
				const observer = new IntersectionObserver((entries) => {
					entries.forEach((entry) => {
						if (entry.isIntersecting) {
							startAnimation();
							observer.unobserve(entry.target);
						}
					});
				}, {
					threshold: 0.18,
					rootMargin: '0px 0px -40px 0px'
				});
				observer.observe(equipmentsGrid);
			} else {
				startAnimation();
			}
		}

		// 5. Animação da dobra institucional (cards empilhados no centro abrindo para as laterais no desktop)
		const instGrid = document.getElementById('institutional-cards-grid');
		if (instGrid) {
			const startInstAnim = () => {
				instGrid.classList.add('is-animated');
			};

			if ('IntersectionObserver' in window) {
				const observerInst = new IntersectionObserver((entries) => {
					entries.forEach((entry) => {
						if (entry.isIntersecting) {
							setTimeout(() => {
								startInstAnim();
							}, 200);
							observerInst.unobserve(entry.target);
						}
					});
				}, {
					threshold: 0.45,
					rootMargin: '0px 0px -60px 0px'
				});
				observerInst.observe(instGrid);
			} else {
				startInstAnim();
			}
		}

		let ticking = false;

		function onScroll() {
			const scrollPos = window.scrollY || window.pageYOffset;
			
			// 1. Logo transition na Hero: some com fade e reduz a escala para o centro quando window.scrollY >= 202
			const scrollThreshold = 202;
			if (scrollPos >= scrollThreshold) {
				heroLogo?.classList.add('is-scrolled');
			} else {
				heroLogo?.classList.remove('is-scrolled');
			}

			// 2. Parallax suave na imagem de fundo da Hero
			if (heroBg && scrollPos < window.innerHeight) {
				(heroBg as HTMLElement).style.transform = `translateY(${scrollPos * 0.15}px) scale(1.04)`;
			}

			// 3. Parallax leve nos cards e grid institucional
			if (parallaxLayer) {
				const rect = (parallaxLayer as HTMLElement).getBoundingClientRect();
				if (rect.top < window.innerHeight && rect.bottom > 0) {
					const offset = (window.innerHeight - rect.top) * 0.06;
					(parallaxLayer as HTMLElement).style.transform = `translateY(-${offset}px)`;
				}
			}

			parallaxCards.forEach((card) => {
				const speed = parseFloat(card.getAttribute('data-speed') || '0.04');
				const rect = card.getBoundingClientRect();
				if (rect.top < window.innerHeight && rect.bottom > 0) {
					const offset = (window.innerHeight - rect.top) * speed;
					(card as HTMLElement).style.transform = `translateY(-${offset}px)`;
				}
			});

			ticking = false;
		}

		window.addEventListener('scroll', () => {
			if (!ticking) {
				window.requestAnimationFrame(onScroll);
				ticking = true;
			}
		}, { passive: true });

		onScroll();
	});
</script>

<style>
	/* ========================================================================= */
	/* 1. HERO RESPONSIVO                                                        */
	/* ========================================================================= */
	.desktop-br {
		display: inline;
	}

	@media (max-width: 992px) {
		.hero-bg-image {
			object-position: calc(78% + 130px) center !important;
		}
		.hero-logo-box {
			display: none !important; /* No mobile o logo já fica exibido no header flutuante */
		}
		.hero-description {
			display: none !important;
		}
		.hero-content-wrapper {
			padding-top: 5.75rem;
			padding-bottom: 2rem;
			padding-left: 1.25rem;
			padding-right: 1.25rem;
		}
	}

	/* ========================================================================= */
	/* 2. HERO: FOTO ORIGINAL ALINHADA ÀS LATERAIS COM LOGO TRANSPARENTE         */
	/* ========================================================================= */
	.hero-section {
		position: relative;
		width: 100vw;
		min-height: 100vh;
		display: flex;
		align-items: center;
		overflow: hidden;
		background-color: #f8fafc;
	}

	.hero-image-container {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
		z-index: 1;
		overflow: hidden;
	}

	.hero-bg-image {
		width: 100%;
		height: 100%;
		object-fit: cover;
		object-position: center;
		display: block;
		will-change: transform;
		transition: transform 0.1s ease-out;
	}

	/* Conteúdo no lado esquerdo */
	.hero-content-wrapper {
		position: relative;
		z-index: 10;
		width: 100%;
		max-width: 1360px;
		margin: 0 auto;
		padding: 8rem 2rem 5rem 2rem;
		display: flex;
		align-items: center;
	}

	.hero-left-column {
		max-width: 660px;
		display: flex;
		flex-direction: column;
		align-items: flex-start;
	}

	/* Logo sobrepondo a imagem na hero com animação de entrada fade + blur */
	.hero-logo-box {
		margin-bottom: 2rem;
		display: inline-block;
		filter: drop-shadow(0 4px 14px rgba(0, 0, 0, 0.12));
		opacity: 1;
		transform: scale(1);
		transform-origin: center center;
		transition: opacity 0.28s cubic-bezier(0.16, 1, 0.3, 1), transform 0.28s cubic-bezier(0.16, 1, 0.3, 1);
		will-change: opacity, transform, filter;
		animation: heroLogoFadeBlurIn 0.85s cubic-bezier(0.16, 1, 0.3, 1) 0.15s backwards;
	}

	/* Quando window.scrollY >= 202, o logo desaparece com fade e reduz a escala para o centro dele mesmo */
	.hero-logo-box.is-scrolled {
		opacity: 0;
		transform: scale(0.75);
		pointer-events: none;
	}

	.hero-overlaid-logo {
		width: 100%;
		max-width: 320px;
		height: auto;
		max-height: 95px;
		object-fit: contain;
		display: block;
	}

	/* Tipografia no tema claro com animação escalonada fade in + blur in */
	.hero-title {
		font-family: 'Montserrat', sans-serif;
		font-size: 2.85rem;
		font-weight: 800;
		line-height: 1.14;
		color: #0f172a;
		letter-spacing: -0.025em;
		margin-bottom: 1.25rem;
		text-shadow: 0 1px 1px rgba(255, 255, 255, 0.9);
		animation: heroTextFadeBlurIn 0.9s cubic-bezier(0.16, 1, 0.3, 1) 0.4s backwards;
		will-change: opacity, filter, transform;
	}

	@media (max-width: 768px) {
		.desktop-br {
			display: none;
		}

		.hero-section {
			min-height: 100svh;
			min-height: 100vh;
			align-items: center;
		}

		.hero-content-wrapper {
			padding-top: 5.75rem;
			padding-bottom: 2rem;
			padding-left: 1.25rem;
			padding-right: 1.25rem;
			background: transparent;
		}

		.hero-left-column {
			background: none;
			border: none;
			box-shadow: none;
			padding: 0;
			max-width: 100%;
			width: 100%;
		}

		.hero-title {
			font-size: clamp(1.75rem, 6.2vw, 2.25rem);
			line-height: 1.18;
			margin-bottom: 0.95rem;
			color: #0f172a;
			font-weight: 800;
			text-shadow: 0 1px 3px rgba(255, 255, 255, 1), 0 0 18px rgba(255, 255, 255, 0.95), 0 0 30px rgba(255, 255, 255, 0.9);
		}

		.hero-overlaid-logo {
			max-width: 240px;
		}

		.hero-description {
			display: none !important;
		}
	}

	.hero-description {
		font-size: 1.125rem;
		line-height: 1.65;
		color: #1e293b;
		font-weight: 500;
		max-width: 580px;
		text-shadow: 0 1px 1px rgba(255, 255, 255, 0.8);
		animation: heroTextFadeBlurIn 0.95s cubic-bezier(0.16, 1, 0.3, 1) 0.65s backwards;
		will-change: opacity, filter, transform;
	}

	/* Animações de Entrada Suaves (Fade In + Blur In) com Atraso Escalonado */
	@keyframes heroLogoFadeBlurIn {
		0% {
			opacity: 0;
			transform: scale(0.96);
			filter: blur(10px) drop-shadow(0 4px 14px rgba(0, 0, 0, 0));
		}
		100% {
			opacity: 1;
			transform: scale(1);
			filter: blur(0px) drop-shadow(0 4px 14px rgba(0, 0, 0, 0.12));
		}
	}

	@keyframes heroTextFadeBlurIn {
		0% {
			opacity: 0;
			filter: blur(8px);
			transform: translateY(16px);
		}
		100% {
			opacity: 1;
			filter: blur(0px);
			transform: translateY(0);
		}
	}

	/* ========================================================================= */
	/* 3. SEGUNDA DOBRA: APRESENTAÇÃO DOS EQUIPAMENTOS                          */
	/* ========================================================================= */
	.equipments-section {
		position: relative;
		width: 100%;
		background-color: #f8fafc;
		padding: 6rem 1.5rem 6.5rem 1.5rem;
		border-top: 1px solid rgba(226, 232, 240, 0.8);
	}

	.equipments-container {
		width: 100%;
		max-width: 1280px;
		margin: 0 auto;
	}

	/* Cabeçalho da Seção */
	.section-header {
		text-align: center;
		max-width: 720px;
		margin: 0 auto 4rem auto;
	}

	.section-badge {
		display: inline-flex;
		align-items: center;
		gap: 0.5rem;
		padding: 0.35rem 0.9rem;
		border-radius: 8px;
		background: #ffffff;
		border: 1px solid rgba(203, 213, 225, 0.9);
		box-shadow: 0 2px 8px rgba(0, 0, 0, 0.03);
		margin-bottom: 1rem;
	}

	.badge-dot {
		width: 7px;
		height: 7px;
		border-radius: 4px;
		background: #e11d48;
		box-shadow: 0 0 8px rgba(225, 29, 72, 0.5);
	}

	.badge-text {
		font-family: 'Inter', monospace;
		font-size: 0.6875rem;
		font-weight: 700;
		letter-spacing: 0.12em;
		text-transform: uppercase;
		color: #334155;
	}

	.section-title {
		font-family: 'Montserrat', sans-serif;
		font-size: 2.25rem;
		font-weight: 800;
		color: #0f172a;
		letter-spacing: -0.025em;
		margin-bottom: 1rem;
		line-height: 1.2;
	}

	.section-subtitle {
		font-size: 1.05rem;
		color: #64748b;
		line-height: 1.6;
	}

	/* Grid de 3 Cards de Equipamentos */
	.equipments-grid {
		display: grid;
		grid-template-columns: repeat(3, 1fr);
		gap: 2.5rem;
		margin-bottom: 3.5rem;
		position: relative;
	}

	/* Linha contínua ao fundo (Desktop) */
	.equipments-bg-line {
		position: absolute;
		top: 172px;
		left: 6%;
		right: 6%;
		height: 3px;
		background: rgba(226, 232, 240, 0.75);
		border-radius: 9999px;
		z-index: 1;
		pointer-events: none;
		overflow: hidden;
	}

	.bg-line-progress {
		position: absolute;
		top: 0;
		left: 0;
		width: 100%;
		height: 100%;
		background: linear-gradient(90deg, #0D1F47 0%, #1e3a8a 55%, #e11d48 100%);
		transform: scaleX(0);
		transform-origin: left center;
		border-radius: 9999px;
		will-change: transform;
	}

	.bg-line-progress::after {
		content: '';
		position: absolute;
		right: 0;
		top: 50%;
		transform: translateY(-50%);
		width: 10px;
		height: 10px;
		border-radius: 50%;
		background: #e11d48;
		box-shadow: 0 0 10px #e11d48, 0 0 18px rgba(225, 29, 72, 0.7);
	}

	.equipments-grid.is-animated .bg-line-progress {
		animation: drawLineHorizontal 1.3s var(--ease-out) forwards;
	}

	@keyframes drawLineHorizontal {
		0% {
			transform: scaleX(0);
		}
		100% {
			transform: scaleX(1);
		}
	}

	/* Card Individual do Equipamento */
	.equipment-card {
		background: #ffffff;
		border-radius: 2rem;
		border: 1px solid rgba(226, 232, 240, 0.85);
		box-shadow: 0 10px 30px -5px rgba(0, 0, 0, 0.04), 0 0 0 1px rgba(0, 0, 0, 0.02);
		padding: 2rem;
		display: flex;
		flex-direction: column;
		justify-content: space-between;
		position: relative;
		z-index: 2;
		opacity: 0;
		transform: translateY(28px) scale(0.97);
		filter: blur(4px);
		transition: opacity 0.65s var(--ease-out),
		            transform 0.65s var(--ease-out),
		            filter 0.65s var(--ease-out),
		            box-shadow 0.25s ease,
		            border-color 0.25s ease;
		will-change: opacity, transform, filter;
	}

	/* Surgimento sequencial sincronizado com o avanço da linha */
