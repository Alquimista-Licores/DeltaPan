---
import logo from '../assets/logo.png';
---

<footer id="contato" class="site-footer">
	<div class="footer-container">
		
		<!-- Linha Superior / Grid de 4 Colunas -->
		<div class="footer-grid">
			
			<!-- Coluna 1: Logo & Resumo -->
			<div class="footer-col-brand">
				<a href="/" class="footer-logo-link" title="DeltaPan — Início">
					<img 
						src={logo.src} 
						alt="DeltaPan Logo" 
						class="footer-logo-img" 
						width="160" 
						height="40" 
					/>
				</a>
				<p class="footer-brand-desc">
					Fabricação de máquinas de alto rendimento para panificação, confeitaria e cozinhas industriais.
				</p>
			</div>

			<!-- Coluna 2: Mapa do Site -->
			<div class="footer-col-nav">
				<h4 class="footer-col-heading">MAPA DO SITE</h4>
				<ul class="footer-nav-list">
					<li><a href="/" class="footer-nav-link">Início</a></li>
					<li><a href="/equipamentos" class="footer-nav-link">Equipamentos</a></li>
					<li><a href="/sobre" class="footer-nav-link">Sobre Nós</a></li>
					<li><a href="/contato" class="footer-nav-link">Contato & Orçamentos</a></li>
				</ul>
			</div>

			<!-- Coluna 3: Telefone e E-mail para Contato -->
			<div class="footer-col-contact">
				<h4 class="footer-col-heading">CONTATO & ATENDIMENTO</h4>
				<ul class="footer-nav-list">
					<li>
						<a href="tel:+551140028922" class="footer-contact-link">
							<svg class="contact-icon" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
								<path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"></path>
							</svg>
							<span>(11) 4002-8922</span>
						</a>
					</li>
					<li>
						<a href="https://wa.me/5511987654321" target="_blank" rel="noopener noreferrer" class="footer-contact-link">
							<svg class="contact-icon" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
								<path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"></path>
							</svg>
							<span>(11) 98765-4321 (WhatsApp)</span>
						</a>
					</li>
					<li>
						<a href="mailto:contato@deltapan.com.br" class="footer-contact-link">
							<svg class="contact-icon" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
								<path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"></path>
								<polyline points="22,6 12,13 2,6"></polyline>
							</svg>
							<span>contato@deltapan.com.br</span>
						</a>
					</li>
					<li>
						<a href="mailto:vendas@deltapan.com.br" class="footer-contact-link">
							<svg class="contact-icon" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
								<path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"></path>
								<polyline points="22,6 12,13 2,6"></polyline>
							</svg>
							<span>vendas@deltapan.com.br</span>
						</a>
					</li>
				</ul>
			</div>

			<!-- Coluna 4: Info / Copyright -->
			<div class="footer-col-legal">
				<div class="footer-icon-badge">
					<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
						<circle cx="12" cy="12" r="10"></circle>
						<line x1="2" y1="12" x2="22" y2="12"></line>
						<path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"></path>
					</svg>
				</div>
				<div class="footer-copyright-text">
					<p>© 2026 DeltaPan Equipamentos Ltda.</p>
					<p>Todos os Direitos Reservados.</p>
				</div>
			</div>

		</div>

	</div>

	<!-- Texto Gigante Cortado na Base: "DELTAPAN" com maior aproximação do conteúdo -->
	<div class="footer-cut-text-wrapper" aria-hidden="true">
		<span class="footer-cut-text">DELTAPAN</span>
	</div>
</footer>

<style>
	.site-footer {
		position: relative;
		width: 100%;
		background-color: #ffffff;
		border-top: 1px solid rgba(226, 232, 240, 0.9);
		padding-top: 3.5rem;
		overflow: hidden;
	}

	.footer-container {
		width: 100%;
		max-width: 1280px;
		margin: 0 auto;
		padding: 0 2rem;
		position: relative;
		z-index: 10;
	}

	.footer-grid {
		display: grid;
		grid-template-columns: 1.4fr 1fr 1.2fr 1.1fr;
		gap: 2.5rem;
		padding-bottom: 0.5rem; /* Reduzido para aproximar as informações da palavra DELTAPAN */
	}

	@media (max-width: 980px) {
		.footer-grid {
			grid-template-columns: 1fr 1fr;
			gap: 2rem;
			padding-bottom: 0.5rem;
		}
	}

	@media (max-width: 640px) {
		.footer-grid {
			grid-template-columns: 1fr;
			gap: 1.75rem;
			padding-bottom: 0.25rem;
		}
	}

	.footer-col-brand {
		display: flex;
		flex-direction: column;
		align-items: flex-start;
	}

	.footer-logo-link {
		display: inline-block;
		margin-bottom: 1.25rem;
		transition: transform 0.25s ease;
	}

	.footer-logo-link:hover {
		transform: scale(1.02);
	}

	.footer-logo-img {
		height: 38px;
		width: auto;
		max-width: 170px;
		object-fit: contain;
		display: block;
	}

	.footer-brand-desc {
		font-size: 0.875rem;
		line-height: 1.6;
		color: #64748b;
		max-width: 260px;
	}

	.footer-col-heading {
		font-family: 'Inter', monospace;
		font-size: 0.6875rem;
		font-weight: 700;
		letter-spacing: 0.15em;
		text-transform: uppercase;
		color: #94a3b8;
		margin-bottom: 1.15rem;
	}

	.footer-nav-list {
		list-style: none;
		padding: 0;
		margin: 0;
		display: flex;
		flex-direction: column;
		gap: 0.65rem;
	}

	.footer-nav-link {
		font-size: 0.875rem;
		font-weight: 500;
		color: #334155;
		transition: color 0.2s ease, transform 0.2s ease;
		display: inline-flex;
		align-items: center;
		gap: 0.4rem;
	}

	.footer-nav-link:hover {
		color: #0f172a;
		transform: translateX(2px);
	}

	.footer-contact-link {
		font-size: 0.875rem;
		font-weight: 500;
		color: #334155;
		transition: color 0.2s ease, transform 0.2s ease;
		display: inline-flex;
		align-items: center;
		gap: 0.5rem;
	}

	.contact-icon {
		color: #94a3b8;
		flex-shrink: 0;
		transition: color 0.2s ease;
	}

	.footer-contact-link:hover {
		color: #0f172a;
		transform: translateX(2px);
	}

	.footer-contact-link:hover .contact-icon {
		color: #e11d48;
	}

	.footer-col-legal {
		display: flex;
		flex-direction: column;
		justify-content: space-between;
		align-items: flex-end;
	}

	@media (max-width: 980px) {
		.footer-col-legal {
			align-items: flex-start;
			justify-content: flex-start;
			gap: 1.5rem;
		}
	}

	.footer-icon-badge {
		color: #cbd5e1;
		transition: color 0.3s ease;
	}

	.footer-col-legal:hover .footer-icon-badge {
		color: #0D1F47;
	}

	.footer-copyright-text {
		text-align: right;
		font-size: 0.8125rem;
		color: #64748b;
		line-height: 1.5;
	}

	@media (max-width: 980px) {
		.footer-copyright-text {
			text-align: left;
		}
	}

	/* Texto Gigante Cortado na Base: "DELTAPAN" com aproximação */
	.footer-cut-text-wrapper {
		width: 100%;
		display: flex;
		justify-content: center;
		align-items: flex-end;
		overflow: hidden;
		pointer-events: none;
		user-select: none;
		margin-top: -1.5rem; /* Margem negativa para aproximar as informações da palavra */
		line-height: 0.65;
	}

	.footer-cut-text {
		font-family: 'Montserrat', sans-serif;
		font-size: clamp(5.5rem, 17.5vw, 24rem);
		font-weight: 900;
		letter-spacing: -0.04em;
		color: rgba(13, 31, 71, 0.06);
		text-transform: uppercase;
		white-space: nowrap;
		display: block;
		transform: translateY(18%);
	}
</style>
