---
interface Props {
	currentPage?: 'inicio' | 'equipamentos' | 'sobre' | 'contato';
}

const { currentPage = 'equipamentos' } = Astro.props;
import logo from '../assets/logo.png';
---

<!-- ========================================================================= -->
<!-- PROGRESSIVE BACKDROP BLUR NO TOPO (70px, 100% TRANSPARENTE)                -->
<!-- ========================================================================= -->
<div class="top-blur-gradient-wrapper" aria-hidden="true">
	<div class="p-blur-1"></div>
	<div class="p-blur-2"></div>
	<div class="p-blur-3"></div>
	<div class="p-blur-4"></div>
	<div class="p-blur-5"></div>
	<div class="p-blur-6"></div>
</div>

<header class="floating-header-wrapper is-scrolled" id="site-header">
	<div class="floating-header-pill">
		<!-- Logo DeltaPan -->
		<a href="/" class="header-logo-link" id="header-logo" title="DeltaPan — Página Inicial">
			<img 
				src={logo.src} 
				alt="DeltaPan Logo" 
				class="header-logo-img" 
				width="135" 
				height="34" 
			/>
		</a>

		<!-- Navegação Centralizada (Desktop) -->
		<nav class="header-nav">
			<a href="/" class={`nav-link ${currentPage === 'inicio' ? 'active' : ''}`}>Início</a>
			<a href="/equipamentos" class={`nav-link ${currentPage === 'equipamentos' ? 'active' : ''}`}>Equipamentos</a>
			<a href="/sobre" class={`nav-link ${currentPage === 'sobre' ? 'active' : ''}`}>Sobre Nós</a>
			<a href="/contato" class={`nav-link ${currentPage === 'contato' ? 'active' : ''}`}>Contato</a>
		</nav>

		<!-- Botão de Ação Direita (Desktop) -->
		<div class="header-cta-box">
			<a href="/contato" class="btn-header-cta">
				<span>Solicitar Orçamento</span>
				<svg class="icon-arrow" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
					<line x1="5" y1="12" x2="19" y2="12"></line>
					<polyline points="12 5 19 12 12 19"></polyline>
				</svg>
			</a>
		</div>

		<!-- Botão Menu Sanduíche (Exclusivo Mobile) -->
		<button 
			type="button" 
			class="mobile-menu-btn" 
			id="mobile-menu-toggle" 
			aria-label="Abrir Menu de Navegação"
			aria-expanded="false"
		>
			<span class="hamburger-line line-1"></span>
			<span class="hamburger-line line-2"></span>
			<span class="hamburger-line line-3"></span>
		</button>
	</div>

	<!-- Menu Dropdown Mobile -->
	<div class="mobile-drawer" id="mobile-drawer" aria-hidden="true">
		<nav class="mobile-nav">
			<a href="/" class={`mobile-nav-link ${currentPage === 'inicio' ? 'active' : ''}`}>Início</a>
			<a href="/equipamentos" class={`mobile-nav-link ${currentPage === 'equipamentos' ? 'active' : ''}`}>Equipamentos</a>
			<a href="/sobre" class={`mobile-nav-link ${currentPage === 'sobre' ? 'active' : ''}`}>Sobre Nós</a>
			<a href="/contato" class={`mobile-nav-link ${currentPage === 'contato' ? 'active' : ''}`}>Contato</a>
		</nav>
		<div class="mobile-cta-wrap">
			<a href="/contato" class="btn-mobile-cta">
				<span>Solicitar Orçamento</span>
				<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
					<line x1="5" y1="12" x2="19" y2="12"></line>
					<polyline points="12 5 19 12 12 19"></polyline>
				</svg>
			</a>
		</div>
	</div>
</header>

<script>
	document.addEventListener('DOMContentLoaded', () => {
		const toggleBtn = document.getElementById('mobile-menu-toggle');
		const drawer = document.getElementById('mobile-drawer');

		if (toggleBtn && drawer) {
			toggleBtn.addEventListener('click', () => {
				const isOpened = toggleBtn.classList.toggle('is-active');
				drawer.classList.toggle('is-open', isOpened);
				toggleBtn.setAttribute('aria-expanded', String(isOpened));
				drawer.setAttribute('aria-hidden', String(!isOpened));
			});

			// Fechar ao clicar em qualquer link
			drawer.querySelectorAll('a').forEach(link => {
				link.addEventListener('click', () => {
					toggleBtn.classList.remove('is-active');
					drawer.classList.remove('is-open');
					toggleBtn.setAttribute('aria-expanded', 'false');
					drawer.setAttribute('aria-hidden', 'true');
				});
			});
		}
	});
</script>

<style>
	/* ========================================================================= */
	/* 1. PROGRESSIVE BACKDROP BLUR NO TOPO (70px, 100% TRANSPARENTE)            */
	/* ========================================================================= */
	.top-blur-gradient-wrapper {
		position: fixed;
		top: 0;
		left: 0;
		width: 100%;
		height: 70px;
		pointer-events: none;
		z-index: 90;
	}

	.top-blur-gradient-wrapper > div {
		position: absolute;
		top: 0;
		left: 0;
		right: 0;
		background: transparent;
	}

	.p-blur-1 {
		height: 70px;
		backdrop-filter: blur(2px);
		-webkit-backdrop-filter: blur(2px);
	}

	.p-blur-2 {
		height: 58px;
		backdrop-filter: blur(3px);
		-webkit-backdrop-filter: blur(3px);
	}

	.p-blur-3 {
		height: 46px;
		backdrop-filter: blur(4px);
		-webkit-backdrop-filter: blur(4px);
	}

	.p-blur-4 {
		height: 35px;
		backdrop-filter: blur(5px);
		-webkit-backdrop-filter: blur(5px);
	}

	.p-blur-5 {
		height: 24px;
		backdrop-filter: blur(6px);
		-webkit-backdrop-filter: blur(6px);
	}

	.p-blur-6 {
		height: 14px;
		backdrop-filter: blur(8px);
		-webkit-backdrop-filter: blur(8px);
	}



	/* ========================================================================= */
	/* 2. HEADER FLUTUANTE                                                       */
	/* ========================================================================= */
	.floating-header-wrapper {
		position: fixed;
		top: 1.25rem;
		left: 0;
		right: 0;
		z-index: 100;
		display: flex;
		flex-direction: column;
		align-items: center;
		padding: 0 1.25rem;
		pointer-events: none;
		transition: all 0.4s cubic-bezier(0.16, 1, 0.3, 1);
	}

	.floating-header-pill {
		pointer-events: auto;
		width: 100%;
		max-width: 1200px;
		display: flex;
		align-items: center;
		justify-content: space-between;
		padding: 0.65rem 1.75rem;
		background: rgba(255, 255, 255, 0.78);
		backdrop-filter: blur(20px) saturate(180%);
		-webkit-backdrop-filter: blur(20px) saturate(180%);
		border-radius: 9999px;
		border: 1px solid rgba(255, 255, 255, 0.75);
		box-shadow: 0 16px 40px -10px rgba(15, 23, 42, 0.12), inset 0 1px 1px rgba(255, 255, 255, 0.9), inset 0 -1px 1px rgba(255, 255, 255, 0.2);
		transition: all 0.35s cubic-bezier(0.16, 1, 0.3, 1);
	}

	.floating-header-pill:hover {
		background: rgba(255, 255, 255, 0.88);
		box-shadow: 0 20px 48px -10px rgba(15, 23, 42, 0.16), inset 0 1px 1px rgba(255, 255, 255, 0.95);
	}

	.header-logo-link {
		display: flex;
		align-items: center;
		opacity: 1;
		max-width: 160px;
		margin-right: 1.25rem;
		transition: transform 0.25s ease;
	}

	.header-logo-link:hover {
		transform: scale(1.02);
	}

	.header-logo-img {
		height: 34px;
		width: auto;
		max-width: 140px;
		object-fit: contain;
		display: block;
	}

	/* Navegação Desktop */
	.header-nav {
		display: flex;
		align-items: center;
		justify-content: center;
		gap: 1.5rem;
		flex: 1;
	}

	.nav-link {
		position: relative;
		font-size: 0.88rem;
		font-weight: 500;
		color: #475569;
		padding: 0.45rem 1rem;
		border-radius: 0;
		background: transparent;
		transition: color 0.2s ease;
		white-space: nowrap;
		display: inline-flex;
		align-items: center;
		justify-content: center;
	}

	.nav-link::after {
		content: '';
		position: absolute;
		bottom: 2px;
		left: 1rem;
		right: 1rem;
		height: 2px;
		background-color: #e11d48;
		border-radius: 2px;
		transform: scaleX(0);
		transform-origin: center;
		transition: transform 0.28s cubic-bezier(0.16, 1, 0.3, 1);
	}

	.nav-link:hover {
		color: #0D1F47;
		background: transparent;
	}

	.nav-link:hover::after {
		transform: scaleX(1);
	}

	.nav-link.active {
		color: #0D1F47;
		font-weight: 700;
		background: transparent;
	}

	.nav-link.active::after {
		transform: scaleX(1);
	}

	/* Botão CTA Desktop */
	.header-cta-box {
		display: flex;
		align-items: center;
		margin-left: 0.5rem;
	}

	.btn-header-cta {
		display: inline-flex;
		align-items: center;
		gap: 0.5rem;
		font-size: 0.8125rem;
		font-weight: 600;
		color: #ffffff;
		background: #0D1F47;
		padding: 0.55rem 1.25rem;
		border-radius: 8px;
		box-shadow: 0 4px 14px rgba(13, 31, 71, 0.22);
		transition: all 0.25s cubic-bezier(0.16, 1, 0.3, 1);
		white-space: nowrap;
	}

	.btn-header-cta:hover {
		background: #162f6b;
		transform: translateY(-1px);
		box-shadow: 0 6px 20px rgba(13, 31, 71, 0.3);
	}

	.icon-arrow {
		transition: transform 0.2s ease;
	}

	.btn-header-cta:hover .icon-arrow {
		transform: translateX(3px);
	}

	/* ========================================================================= */
	/* 3. MENU SANDUÍCHE (MOBILE)                                                */
	/* ========================================================================= */
	.mobile-menu-btn {
		display: none; /* Oculto no desktop */
		flex-direction: column;
		justify-content: center;
		align-items: center;
		gap: 5px;
		width: 32px;
		height: 32px;
		padding: 0;
		background: transparent;
		border: none;
		cursor: pointer;
		color: #0D1F47;
		transition: transform 0.2s ease;
	}

	.mobile-menu-btn:hover {
		background: transparent;
	}

	.hamburger-line {
		display: block;
		width: 22px;
		height: 2px;
		background-color: currentColor;
		border-radius: 2px;
		transition: transform 0.3s cubic-bezier(0.16, 1, 0.3, 1), opacity 0.2s ease;
	}

	/* Animação do botão para X */
	.mobile-menu-btn.is-active .line-1 {
		transform: translateY(7px) rotate(45deg);
	}

	.mobile-menu-btn.is-active .line-2 {
		opacity: 0;
		transform: scaleX(0);
	}

	.mobile-menu-btn.is-active .line-3 {
		transform: translateY(-7px) rotate(-45deg);
	}

	/* Painel Gaveta Mobile */
	.mobile-drawer {
		display: none;
		pointer-events: auto;
		width: 100%;
		max-width: 1200px;
		margin-top: 0.6rem;
		background: rgba(255, 255, 255, 0.82);
		backdrop-filter: blur(24px) saturate(180%);
		-webkit-backdrop-filter: blur(24px) saturate(180%);
		border: 1px solid rgba(255, 255, 255, 0.75);
		border-radius: 20px;
		box-shadow: 0 20px 45px -10px rgba(15, 23, 42, 0.16), inset 0 1px 1px rgba(255, 255, 255, 0.9);
		padding: 1.25rem;
		opacity: 0;
		transform: translateY(-10px);
		transition: opacity 0.25s ease, transform 0.25s ease;
	}

	.mobile-drawer.is-open {
		display: flex;
		flex-direction: column;
		opacity: 1;
		transform: translateY(0);
	}

	.mobile-nav {
		display: flex;
		flex-direction: column;
		gap: 0.35rem;
		width: 100%;
	}

	.mobile-nav-link {
		font-size: 1rem;
		font-weight: 500;
		color: #334155;
		text-decoration: none;
		padding: 0.75rem 1rem;
		border-radius: 12px;
		transition: all 0.2s ease;
	}

	.mobile-nav-link:hover {
		background-color: rgba(13, 31, 71, 0.05);
		color: #0D1F47;
	}

	.mobile-nav-link.active {
		background-color: rgba(225, 29, 72, 0.08);
		color: #e11d48;
		font-weight: 600;
	}

	.mobile-cta-wrap {
		margin-top: 0.75rem;
		padding-top: 0.75rem;
		border-top: 1px solid #f1f5f9;
	}

	.btn-mobile-cta {
		display: flex;
		align-items: center;
		justify-content: center;
		gap: 0.6rem;
		width: 100%;
		background-color: #0D1F47;
		color: #ffffff;
		font-size: 0.95rem;
		font-weight: 600;
		padding: 0.85rem 1.5rem;
		border-radius: 14px;
		text-decoration: none;
		transition: all 0.25s ease;
	}

	.btn-mobile-cta:hover {
		background-color: #e11d48;
	}

	/* ========================================================================= */
	/* 4. RESPONSIVIDADE MOBILE: APENAS LOGO E MENU SANDUÍCHE NO HEADER          */
	/* ========================================================================= */
	@media (max-width: 992px) {
		.header-nav {
			display: none !important;
		}

		/* Oculta o botão de orçamento no pill do mobile */
		.header-cta-box {
			display: none !important;
		}

		/* Exibe o menu sanduíche */
		.mobile-menu-btn {
			display: flex !important;
		}

		.header-logo-link {
			display: flex !important;
			opacity: 1 !important;
			pointer-events: auto !important;
		}

		.floating-header-wrapper {
			top: 0.75rem;
			padding: 0 0.75rem;
		}

		.floating-header-pill {
			padding: 0.55rem 1rem 0.55rem 1.25rem;
			background: rgba(255, 255, 255, 0.8);
			backdrop-filter: blur(20px) saturate(180%);
			-webkit-backdrop-filter: blur(20px) saturate(180%);
			border: 1px solid rgba(255, 255, 255, 0.75);
			box-shadow: 0 16px 40px -10px rgba(15, 23, 42, 0.12), inset 0 1px 1px rgba(255, 255, 255, 0.9);
		}

		.header-logo-img {
			height: 30px;
			max-width: 125px;
		}
	}
</style>
