---
import cenarioImg from '../assets/cenario-equipamentos.png';
import aeImg from '../assets/AE sombra.png';
import batedeiraImg from '../assets/batedeira sombra.png';
import cilindroImg from '../assets/cilindro sombra.png';

export interface MachineShowcaseItem {
	id: string;
	name: string;
	model: string;
	shortDesc: string;
	img: any;
	alt: string;
}

interface Props {
	machines?: MachineShowcaseItem[];
}

const defaultMachines: MachineShowcaseItem[] = [
	{
		id: 'amassadeira-espiral',
		name: 'Amassadeira Espiral',
		model: 'Linha AE 40 / AE 80 kg',
		shortDesc: 'Desenvolvimento do glúten e alto rendimento',
		img: aeImg,
		alt: 'Amassadeira Espiral Industrial DeltaPan'
	},
	{
		id: 'batedeira-planetaria',
		name: 'Batedeira Planetária',
		model: 'Linha BP 20 / BP 40 Litros',
		shortDesc: 'Precisão máxima para massas leves e cremes',
		img: batedeiraImg,
		alt: 'Batedeira Planetária Industrial DeltaPan'
	},
	{
		id: 'cilindro-laminador',
		name: 'Cilindro Laminador',
		model: 'Linha CL 500 / CL 600 mm',
		shortDesc: 'Laminação homogênea e abertura regulável',
		img: cilindroImg,
		alt: 'Cilindro Laminador / Modeladora DeltaPan'
	}
];

const { machines = defaultMachines } = Astro.props;
const cols = machines.length;
---

<!-- ========================================================================= -->
<!-- SHOWCASE: COMPOSIÇÃO COM FUNDO LIMITADO E MÁQUINAS SOBREPOSTAS            -->
<!-- ========================================================================= -->
<section class="showcase-section">
	<div class="showcase-outer-container">
		
		<!-- Moldura Principal (Fundo limitado, mais largo que o header 1200px -> 1380px) -->
		<div class="showcase-composite-card">
			
			<!-- 1. Cenário de Fundo com Máquinas Sobrepostas -->
			<div class="scene-stage">
				<!-- Imagem de Fundo (Ambiente de Panificação Industrial) -->
				<img 
					src={cenarioImg.src} 
					alt="Cenário de Produção DeltaPan" 
					class="scene-background-img"
				/>

				<!-- Camada das Máquinas Sobrepostas no Chão da Cena -->
				<div class={`machines-overlay-grid cols-${cols}`}>
					{machines.map((item, idx) => (
						<div 
							class={`machine-col machine-${idx}`} 
							data-open-modal={item.id} 
							role="button" 
							tabindex="0" 
							title={`Clique para ver detalhes de ${item.name}`}
						>
							<div class="machine-inner">
								<img 
									src={item.img.src} 
									alt={item.alt} 
									class={`machine-item-img img-${item.id}`} 
									loading="eager"
								/>
							</div>
						</div>
					))}
				</div>
			</div>

			<!-- 2. Faixa Inferior com Informações dos Modelos (Fundo 100% transparente) -->
			<div class="models-bar">
				<div class={`models-columns-grid cols-${cols}`}>
					{machines.map((item) => (
						<div 
							class="model-info-column" 
							data-open-modal={item.id} 
							role="button" 
							tabindex="0" 
							title={`Clique para ver detalhes de ${item.name}`}
						>
							<h2 class="model-title">
								<span>{item.name}</span>
							</h2>
							<p class="model-name">{item.model}</p>
							<p class="model-desc">{item.shortDesc}</p>
						</div>
					))}
				</div>
			</div>

		</div>

	</div>
</section>

<style>
	/* ========================================================================= */
	/* SHOWCASE: FUNDO LIMITADO & MOLDURA ARREDONDADA COM SOMBRA                */
	/* ========================================================================= */
	.showcase-section {
		width: 100%;
		padding: 1.5rem 1.25rem 3.5rem 1.25rem;
	}

	/* O header possui max-width: 1200px. Este container tem 1380px (um pouco maior nas laterais) */
	.showcase-outer-container {
		width: 100%;
		max-width: 1380px;
		margin: 0 auto;
	}

	/* Container da composição do showcase com fundo transparente */
	.showcase-composite-card {
		position: relative;
		width: 100%;
		background: transparent;
		border-radius: 0;
		overflow: visible;
		box-shadow: none;
		border: none;
	}

	/* 1. Palco do Cenário com Imagem de Fundo e Máquinas Sobrepostas (Moldura com cantos menos arredondados) */
	.scene-stage {
		position: relative;
		width: 100%;
		/* Proporção compacta em altura */
		aspect-ratio: 16 / 4.8;
		min-height: 320px;
		background: #f1f5f9;
		overflow: hidden;
		border-radius: 8px;
		box-shadow: 0 16px 35px -10px rgba(15, 23, 42, 0.08);
		display: flex;
		align-items: flex-end;
	}

	@media (max-width: 1024px) {
		.scene-stage {
			aspect-ratio: 16 / 5.5;
			min-height: 290px;
		}
	}

	@media (max-width: 768px) {
		.scene-stage {
			aspect-ratio: 16 / 6.5;
			min-height: 250px;
		}
	}

	@media (max-width: 540px) {
		.scene-stage {
			aspect-ratio: 16 / 8.5;
			min-height: 200px;
		}
	}

	.scene-background-img {
		position: absolute;
		top: 0;
		left: 0;
		width: 100%;
		height: 100%;
		object-fit: cover;
		object-position: center bottom; /* Corta o topo da imagem de fundo preservando o chão */
		z-index: 1;
		pointer-events: none;
		user-select: none;
	}

	/* Grid das Máquinas Sobrepostas sobre o chão da imagem de fundo */
	.machines-overlay-grid {
		position: relative;
		z-index: 5;
		width: 100%;
		height: 100%;
		display: grid;
		grid-template-columns: repeat(3, 1fr);
		align-items: flex-end;
		padding: 0 1.5rem 0.35rem 1.5rem; /* Posiciona os equipamentos bem próximos da base da moldura */
	}

	.machines-overlay-grid.cols-2 {
		grid-template-columns: repeat(2, 1fr);
		padding: 0 2.5rem 0.35rem 2.5rem;
	}

	.machine-col {
		height: 100%;
		display: flex;
		align-items: flex-end;
		justify-content: center;
		position: relative;
		cursor: pointer;
		outline: none;
	}

	.machine-col:focus-visible {
		outline: 2px solid #e11d48;
		outline-offset: 4px;
		border-radius: 12px;
	}

	.machine-inner {
		width: 100%;
		height: 100%;
		display: flex;
		align-items: flex-end; /* Alinhamento pela base comum */
		justify-content: center;
		transition: transform 0.35s cubic-bezier(0.16, 1, 0.3, 1), filter 0.35s ease;
	}

	.machine-col:hover .machine-inner {
		transform: translateY(-8px) scale(1.03);
		filter: drop-shadow(0 20px 30px rgba(0, 0, 0, 0.3));
	}

	.machine-item-img {
		display: block;
		width: auto;
		object-fit: contain;
		object-position: bottom center;
		vertical-align: bottom;
		filter: drop-shadow(0 14px 20px rgba(0, 0, 0, 0.2));
		pointer-events: none;
		user-select: none;
	}

	/* Equipamentos ampliados para maior destaque visual sobre o cenário */
	.img-amassadeira-espiral,
	.img-ae {
		height: clamp(192px, 19.2vw, 276px);
		max-height: 72%;
		max-width: 90%;
	}

	.img-batedeira-planetaria,
	.img-batedeira {
		height: clamp(216px, 21.6vw, 312px);
		max-height: 80%;
		max-width: 72%;
	}

	.img-cilindro-laminador,
	.img-cilindro {
		height: clamp(204px, 20.4vw, 294px);
		max-height: 75%;
		max-width: 90%;
	}

	.img-modeladora-esteira,
	.machine-col[data-open-modal="modeladora-esteira"] .machine-item-img {
		height: clamp(225px, 22.5vw, 324px);
		max-height: 85%;
		max-width: 86%;
	}

	.img-divisora-mesa,
	.machine-col[data-open-modal="divisora-mesa"] .machine-item-img {
		height: clamp(235px, 23.5vw, 340px);
		max-height: 88%;
		max-width: 88%;
		transform: scale(1.2) translateY(-10px);
	}

	.img-divisora-coluna,
	.machine-col[data-open-modal="divisora-coluna"] .machine-item-img {
		height: clamp(220px, 22vw, 310px);
		max-height: 85%;
		max-width: 85%;
	}

	/* 2. Faixa Inferior de Nomes dos Modelos (Fundo 100% transparente) */
	.models-bar {
		position: relative;
		z-index: 10;
		width: 100%;
		background: transparent;
		padding: 1.5rem 1.5rem 2rem 1.5rem;
		border: none;
	}

	.models-columns-grid {
		width: 100%;
		display: grid;
		grid-template-columns: repeat(3, 1fr);
		gap: 1.5rem;
		text-align: center;
	}

	.models-columns-grid.cols-2 {
		grid-template-columns: repeat(2, 1fr);
		gap: 1.5rem;
	}

	.model-info-column {
		min-width: 0;
		display: flex;
		flex-direction: column;
		align-items: center;
		padding: 0.5rem 0.4rem;
		border-radius: 12px;
		transition: all 0.25s ease;
		overflow-wrap: break-word;
		word-break: normal;
		cursor: pointer;
		outline: none;
	}

	.model-info-column:hover {
		transform: translateY(-3px);
		background: rgba(255, 255, 255, 0.4);
	}

	.model-info-column:focus-visible {
		outline: 2px solid #e11d48;
		outline-offset: 2px;
	}

	.model-title {
		font-family: 'Inter', -apple-system, BlinkMacSystemFont, sans-serif;
		font-size: clamp(0.85rem, 1.6vw, 1.3rem);
		font-weight: 600;
		color: #0f172a;
		letter-spacing: -0.01em;
		margin-bottom: 0.25rem;
		line-height: 1.2;
		text-align: center;
		white-space: normal;
		overflow-wrap: break-word;
		word-break: normal;
		width: 100%;
		transition: color 0.2s ease;
	}

	.model-info-column:hover .model-title {
		color: #e11d48;
	}


	.model-name {
		font-family: 'Inter', sans-serif;
		font-size: clamp(0.75rem, 1.1vw, 0.92rem);
		font-weight: 500;
		color: #475569;
		margin-bottom: 0.2rem;
		line-height: 1.3;
		text-align: center;
		white-space: normal;
		overflow-wrap: break-word;
		width: 100%;
	}

	.model-desc {
		font-family: 'Inter', sans-serif;
		font-size: clamp(0.75rem, 1vw, 0.85rem);
		color: #64748b;
		line-height: 1.4;
		max-width: 280px;
	}

	@media (max-width: 768px) {
		.models-bar {
			padding: 1rem 0.5rem 1.25rem 0.5rem;
		}

		.models-columns-grid {
			gap: 0.5rem;
		}

		.model-info-column {
			padding: 0 0.15rem;
		}

		.model-title {
			font-size: clamp(0.78rem, 2.3vw, 0.95rem);
			white-space: normal;
			line-height: 1.2;
		}

		.model-name {
			font-size: clamp(0.68rem, 1.9vw, 0.8rem);
			white-space: normal;
			line-height: 1.2;
		}
	}

	/* No mobile, mantém SEMPRE um ao lado do outro, permitindo quebra de linha limpa */
	@media (max-width: 640px) {
		.models-bar {
			padding: 0.85rem 0.25rem 1rem 0.25rem;
		}

		.models-columns-grid {
			grid-template-columns: 1fr 1fr 1fr; /* Força 3 colunas contínuas */
			gap: 0.25rem;
		}

		.model-info-column {
			padding: 0 0.1rem;
			border: none;
		}

		.model-title {
			font-size: clamp(0.7rem, 2.8vw, 0.82rem);
			font-weight: 600;
			white-space: normal;
			line-height: 1.15;
		}

		.model-name {
			font-size: clamp(0.6rem, 2.2vw, 0.72rem);
			line-height: 1.2;
			white-space: normal;
		}

		/* Oculta descrição longa no mobile de 3 colunas para garantir disposição lado a lado limpa */
		.models-columns-grid:not(.cols-2) .model-desc {
			display: none;
		}
	}

	/* Ajuste específico para 2 equipamentos por linha quando tela <= 500px */
	@media (max-width: 500px) {
		.showcase-section {
			padding: 0.75rem 0.75rem 1.75rem 0.75rem;
		}

		.scene-stage {
			aspect-ratio: 16 / 9;
			min-height: 180px;
		}

		.machines-overlay-grid.cols-2 {
			grid-template-columns: 1fr 1fr !important;
			padding: 0 1rem 0.35rem 1rem;
			height: 100%;
			min-height: 0;
		}

		.machines-overlay-grid.cols-2 .machine-col {
			height: 100%;
			min-height: 0;
		}

		.machines-overlay-grid.cols-2 .machine-inner {
			height: 100%;
			min-height: 0;
			align-items: flex-end;
		}

		.models-columns-grid.cols-2 {
			grid-template-columns: 1fr 1fr !important;
			gap: 0.75rem;
			padding: 0.75rem 0.25rem;
		}

		/* Sobrescreve TODOS os clamps desktop das máquinas em 2 colunas para nunca ultrapassar o chão */
		.cols-2 .machine-item-img,
		.cols-2 .machine-col .machine-item-img,
		.cols-2 .machine-col[data-open-modal] .machine-item-img {
			height: auto !important;
			max-height: 82% !important;
			max-width: 88% !important;
			transform-origin: bottom center !important;
			align-self: flex-end;
		}

		.cols-2 .img-divisora-mesa,
		.cols-2 .machine-col[data-open-modal="divisora-mesa"] .machine-item-img {
			transform: scale(1.12) translateY(0) !important;
			transform-origin: bottom center !important;
		}

		.cols-2 .model-title {
			font-size: 0.925rem;
			line-height: 1.25;
		}

		.cols-2 .model-name {
			font-size: 0.75rem;
			line-height: 1.25;
		}

		.cols-2 .model-desc {
			display: block;
			font-size: 0.6875rem;
			line-height: 1.35;
			color: #64748b;
			margin-top: 0.2rem;
		}
	}
</style>
