---
import aeImg from '../assets/AE sombra.png';
import batedeiraImg from '../assets/batedeira sombra.png';
import cilindroImg from '../assets/cilindro sombra.png';

export interface MachineItem {
	id: string;
	name: string;
	model: string;
	shortDesc: string;
	category: string;
	img: any;
	alt: string;
	whatsappMsg?: string;
	description: string;
	differentials: { title: string; desc: string }[];
	specs: { label: string; value: string }[];
	laudoNr12Url?: string;
	manualUrl?: string;
	model3dUrl?: string;
}

export const defaultMachines: MachineItem[] = [
	{
		id: 'amassadeira-espiral',
		name: 'Amassadeira Espiral',
		model: 'Linha AE 40 / AE 80 kg',
		shortDesc: 'Desenvolvimento do glúten e alto rendimento',
		category: 'Panificação Pesada',
		img: aeImg,
		alt: 'Amassadeira Espiral Industrial DeltaPan',
		whatsappMsg: 'Olá! Gostaria de solicitar um orçamento para o equipamento: Amassadeira Espiral (Linha AE 40 / AE 80 kg).',
		description: 'Projetada para atender demandas intensivas de panificação industrial e padarias que exigem o máximo de rendimento e padronização. Seus movimentos perfeitamente sincronizados entre o batedor espiral e o tacho em aço inox garantem rápida formação da rede de glúten, menor aquecimento da massa e absorção ideal de hidratação.',
		differentials: [
			{ title: 'Tacho e Espiral em Aço Inox 304', desc: 'Acabamento sanitário de grau alimentício com alta durabilidade e fácil higienização' },
			{ title: 'Dupla Velocidade com Inversor', desc: 'Mistura lenta inicial e desenvolvimento rápido programável com transição suave' },
			{ title: 'Transmissão Dupla Reforçada', desc: 'Duplo conjunto de correias sincronizadas de alto torque, silencioso e sem vibrações' },
			{ title: 'Segurança Total NR-12', desc: 'Grade basculante de proteção com microchave codificada e freio de parada instantânea' }
		],
		specs: [
			{ label: 'Capacidade de Massa Pronta', value: '40 kg a 80 kg' },
			{ label: 'Capacidade de Farinha', value: '25 kg a 50 kg' },
			{ label: 'Motorização', value: '5,0 cv / 7,5 cv trifásico' },
			{ label: 'Tensão Elétrica', value: '220V / 380V Trifásico' }
		],
		laudoNr12Url: '#',
		manualUrl: '#'
	},
	{
		id: 'batedeira-planetaria',
		name: 'Batedeira Planetária',
		model: 'Linha BP 20 / BP 40 Litros',
		shortDesc: 'Precisão máxima para massas leves e cremes',
		category: 'Confeitaria & Panificação',
		img: batedeiraImg,
		alt: 'Batedeira Planetária Industrial DeltaPan',
		whatsappMsg: 'Olá! Gostaria de solicitar um orçamento para o equipamento: Batedeira Planetária (Linha BP 20 / BP 40 Litros).',
		description: 'Versatilidade incomparável para confeitarias, cozinhas profissionais e indústrias de panificação. O movimento planetário sincrônico aliado aos 3 batedores intercambiáveis permite preparar desde cremes delicados, merengues e mousses até massas densas de tortas e pães leves com aeração perfeita e acabamento homogêneo.',
		differentials: [
			{ title: 'Kit com 3 Batedores Inclusos', desc: 'Globo para aeração máxima, Raquete para cremes e massas médias, e Gancho' },
			{ title: 'Engrenagens em Banho de Óleo', desc: 'Conjunto helicoidal usinado em aço especial garantindo operação estável e silenciosa' },
			{ title: 'Painel Eletrônico com Temporizador', desc: 'Controle preciso de tempo e velocidades programáveis para padrão industrial' },
			{ title: 'Elevação Ergonômica com Trava', desc: 'Alavanca de engate rápido com sensor de proteção intertravado NR-12' }
		],
		specs: [
			{ label: 'Capacidade Volumétrica', value: '20 Litros / 40 Litros' },
			{ label: 'Material do Tacho', value: 'Aço inoxidável estampado sanitário' },
			{ label: 'Potência do Motor', value: '1,5 cv / 2,5 cv com inversor' },
			{ label: 'Tensão Elétrica', value: '220V Monofásico / Trifásico' }
		],
		laudoNr12Url: '#',
		manualUrl: '#'
	},
	{
		id: 'cilindro-laminador',
		name: 'Cilindro Laminador',
		model: 'Linha CL 500 / CL 600 mm',
		shortDesc: 'Laminação homogênea e abertura regulável',
		category: 'Laminação & Moldagem',
		img: cilindroImg,
		alt: 'Cilindro Laminador / Modeladora DeltaPan',
		whatsappMsg: 'Olá! Gostaria de solicitar um orçamento para o equipamento: Cilindro Laminador (Linha CL 500 / CL 600 mm).',
		description: 'Desenvolvido para sovar e laminar massas de pães, folhados, pizzas e salgados com espessura rigorosamente uniforme. Seus rolos maciços cromados e retificados oferecem regulagem milimétrica contínua, combinando alta produtividade operacional com ergonomia e facilidade de alimentação contínua.',
		differentials: [
			{ title: 'Rolos Retificados e Cromados', desc: 'Aço especial usinado de alta dureza com 500 mm ou 600 mm de largura útil' },
			{ title: 'Regulagem Milimétrica Precisa', desc: 'Manípulo ergonômico com escala visual rápida e trava anti-deslocamento' },
			{ title: 'Raspadores Duplos Removíveis', desc: 'Higienização simples e rápida sem a necessidade de ferramentas mecânicas' },
			{ title: 'Freio Motorizado Instantâneo', desc: 'Botão de parada tipo cogumelo e proteções mecânicas em total conformidade NR-12' }
		],
		specs: [
			{ label: 'Largura Útil dos Rolos', value: '500 mm / 600 mm' },
			{ label: 'Diâmetro dos Rolos', value: '125 mm / 160 mm retificados' },
			{ label: 'Potência do Motor', value: '3,0 cv / 4,0 cv trifásico' },
			{ label: 'Tensão Elétrica', value: '220V / 380V Trifásico' }
		],
		laudoNr12Url: '#',
		manualUrl: '#'
	}
];

interface Props {
	machines?: MachineItem[];
}

const { machines = defaultMachines } = Astro.props;
---

<!-- ========================================================================= -->
<!-- COMPONENTE REUTILIZÁVEL: MODAL DE DETALHES DO PRODUTO                      -->
<!-- ========================================================================= -->
<div 
	id="product-modal-backdrop" 
	class="modal-backdrop" 
	role="dialog" 
	aria-modal="true" 
	aria-hidden="true"
>
	<!-- Card com Cantos 100% Arredondados e Overflow Oculto -->
	<div class="modal-card-container">
		
		<!-- Botão Fechar Modal (X) -->
		<button 
			type="button" 
			class="modal-close-btn" 
			id="modal-close-btn" 
			aria-label="Fechar detalhes do equipamento"
		>
			<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
				<line x1="18" y1="6" x2="6" y2="18"></line>
				<line x1="6" y1="6" x2="18" y2="18"></line>
			</svg>
		</button>

		<!-- Área de Scroll Interna com Scrollbar Fina e Discreta -->
		<div class="modal-scroll-body">
			<div class="modal-inner-layout">
				
				<!-- COLUNA ESQUERDA: FOTO DO PRODUTO & BOTÃO 3D -->
				<div class="modal-media-col">
					<div class="modal-image-box" id="modal-image-box">
						
						<!-- Botão Discreto de Visualização em 3D Sobreposto -->
						<button 
							type="button" 
							class="btn-3d-overlay" 
							id="btn-3d-toggle" 
							title="Ativar rotação e visualização 3D"
						>
							<svg class="cube-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
								<path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"></path>
								<polyline points="3.27 6.96 12 12.01 20.73 6.96"></polyline>
								<line x1="12" y1="22.08" x2="12" y2="12"></line>
							</svg>
							<span id="btn-3d-text">Ver em 3D</span>
						</button>

						<!-- Imagem do Equipamento -->
						<div class="image-perspective-stage" id="image-stage">
							<img 
								src="" 
								alt="" 
								id="modal-product-img" 
								class="modal-main-img" 
							/>
						</div>

						<!-- Visualizador 3D Interativo (Rotação habilitada, Zoom desativado) -->
						<div class="model-3d-stage" id="model-3d-stage" style="display: none;">
							<model-viewer
								id="modal-3d-viewer"
								src=""
								alt="Visualização 3D do Equipamento"
								camera-controls
								disable-zoom
								disable-pan
								interaction-prompt="none"
								shadow-intensity="1.2"
								shadow-softness="0.5"
								exposure="1.0"
								auto-rotate
								auto-rotate-delay="1000"
								rotation-per-second="20deg"
							>
								<div class="model-loading-indicator" slot="poster">
									<div class="model-spinner"></div>
									<span>Carregando modelo 3D...</span>
								</div>
							</model-viewer>
						</div>

						<div class="mode-3d-notice" id="mode-3d-notice">
							<span class="pulse-dot"></span>
							<span>Gire em 360° com o mouse ou toque</span>
						</div>

					</div>

					<!-- Especificações Técnicas Rápidas -->
					<div class="modal-quick-specs">
						<h4 class="specs-heading">Ficha Técnica</h4>
						<div class="specs-grid" id="modal-specs-list">
							<!-- Inserido dinamicamente via JS -->
						</div>
					</div>
				</div>

				<!-- COLUNA DIREITA: INFORMAÇÕES, ORÇAMENTO, DIFERENCIAIS E DOWNLOADS -->
				<div class="modal-info-col">
					
					<!-- Cabeçalho do Produto -->
					<div class="modal-header-block">
						<div class="modal-badges-row">
							<span class="modal-category-tag" id="modal-category">Categoria</span>
							<span class="modal-model-tag" id="modal-model">Modelo</span>
						</div>
						<h2 class="modal-title" id="modal-title">Nome do Equipamento</h2>
					</div>

					<!-- Descrição do Produto -->
					<div class="modal-desc-box">
						<p class="modal-desc" id="modal-desc">
							Descrição completa do equipamento e sua aplicabilidade na produção...
						</p>
					</div>

					<!-- Botão Principal: Solicitar Orçamento via WhatsApp -->
					<div class="modal-cta-box">
						<a 
							href="#" 
							id="modal-whatsapp-cta" 
							target="_blank" 
							rel="noopener noreferrer" 
							class="btn-whatsapp-quote"
						>
							<!-- Ícone WhatsApp Oficial -->
							<svg class="whatsapp-icon" width="22" height="22" viewBox="0 0 24 24" fill="currentColor">
								<path d="M12.031 2C6.495 2 2 6.495 2 12.031c0 1.97.568 3.81 1.554 5.373L2.094 22l4.767-1.428a9.98 9.98 0 0 0 5.17 1.459h.004c5.535 0 10.031-4.495 10.031-10.031A10.03 10.03 0 0 0 12.031 2zm0 18.257h-.003a8.21 8.21 0 0 1-4.2-1.157l-.3-.178-2.825.845.85-2.753-.195-.311a8.225 8.225 0 0 1-1.265-4.472c0-4.542 3.696-8.238 8.238-8.238 4.542 0 8.238 3.696 8.238 8.238 0 4.542-3.696 8.238-8.238 8.238zm4.516-6.17c-.247-.124-1.463-.722-1.69-.804-.227-.082-.392-.124-.557.124-.165.247-.64.804-.784.969-.144.165-.288.186-.535.062-.247-.124-1.043-.385-1.986-1.226-.734-.655-1.23-1.464-1.374-1.711-.144-.247-.015-.38.109-.503.111-.111.247-.288.371-.433.124-.144.165-.247.247-.412.082-.165.041-.309-.021-.433-.062-.124-.557-1.34-.763-1.835-.2-.482-.403-.417-.557-.425l-.474-.008c-.165 0-.433.062-.66.309-.227.247-.866.845-.866 2.062s.887 2.392 1.01 2.557c.124.165 1.745 2.664 4.227 3.737.59.255 1.052.408 1.411.522.593.188 1.133.161 1.56.098.477-.07 1.463-.598 1.669-1.175.206-.577.206-1.072.144-1.175-.062-.103-.227-.165-.474-.288z"/>
							</svg>
							<span class="btn-cta-text">
								<strong>Solicitar Orçamento</strong>
								<small>Atendimento direto de fábrica via WhatsApp</small>
							</span>
							<svg class="arrow-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
								<polyline points="9 18 15 12 9 6"></polyline>
							</svg>
						</a>
					</div>

					<!-- Seção de Diferenciais -->
					<div class="modal-differentials-box">
						<h3 class="differentials-title">Diferenciais e Destaques Construtivos</h3>
						<div class="differentials-list" id="modal-differentials-list">
							<!-- Inserido dinamicamente via JS -->
						</div>
					</div>

					<!-- Seção de Downloads / Documentação Técnica -->
					<div class="modal-downloads-box">
						<h4 class="downloads-heading">Documentos e Certificações</h4>
						<div class="downloads-actions-row">
							
							<!-- Botão Baixar Laudo NR-12 -->
							<a 
								href="#" 
								id="modal-laudo-btn" 
								class="btn-doc-download btn-nr12" 
								target="_blank" 
								rel="noopener noreferrer"
							>
								<div class="doc-icon-wrap">
									<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
										<path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path>
										<polyline points="9 12 11 14 15 10"></polyline>
									</svg>
								</div>
								<div class="doc-text-wrap">
									<span class="doc-title">Laudo Técnico NR-12</span>
									<span class="doc-sub">Certificado de Conformidade</span>
								</div>
								<svg class="dl-arrow" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
									<path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
									<polyline points="7 10 12 15 17 10"></polyline>
									<line x1="12" y1="15" x2="12" y2="3"></line>
								</svg>
							</a>

							<!-- Botão Baixar Manual do Equipamento -->
							<a 
								href="#" 
								id="modal-manual-btn" 
								class="btn-doc-download btn-manual" 
								target="_blank" 
								rel="noopener noreferrer"
							>
								<div class="doc-icon-wrap">
									<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
										<path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"></path>
										<path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"></path>
										<line x1="10" y1="6" x2="16" y2="6"></line>
										<line x1="10" y1="10" x2="16" y2="10"></line>
									</svg>
								</div>
								<div class="doc-text-wrap">
									<span class="doc-title">Manual do Equipamento</span>
									<span class="doc-sub">Instalação, Operação & Manutenção</span>
								</div>
								<svg class="dl-arrow" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
									<path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
									<polyline points="7 10 12 15 17 10"></polyline>
									<line x1="12" y1="15" x2="12" y2="3"></line>
								</svg>
							</a>

						</div>
					</div>

				</div>

			</div>
		</div>

	</div>
</div>

<!-- Importação do visualizador 3D Google Model Viewer e Decodificador Meshopt -->
<script src="/models/meshopt_decoder.js" is:inline></script>
<script type="module" src="/models/model-viewer.min.js"></script>

<!-- Serialização dos dados das máquinas para consumo no script cliente -->
<script define:vars={{ machines }}>
	window.__DELTAPAN_MACHINES__ = machines;
</script>

<script>
	document.addEventListener('DOMContentLoaded', () => {
		const backdrop = document.getElementById('product-modal-backdrop');
		const closeBtn = document.getElementById('modal-close-btn');
		const imgEl = document.getElementById('modal-product-img');
		const imageBox = document.getElementById('modal-image-box');
		const imageStage = document.getElementById('image-stage');
		const model3dStage = document.getElementById('model-3d-stage');
		const modelViewer = document.getElementById('modal-3d-viewer');
		const btn3d = document.getElementById('btn-3d-toggle');
		const btn3dText = document.getElementById('btn-3d-text');
		const notice3d = document.getElementById('mode-3d-notice');
		const titleEl = document.getElementById('modal-title');
		const modelEl = document.getElementById('modal-model');
		const categoryEl = document.getElementById('modal-category');
		const descEl = document.getElementById('modal-desc');
		const whatsappCta = document.getElementById('modal-whatsapp-cta');
		const specsList = document.getElementById('modal-specs-list');
		const diffList = document.getElementById('modal-differentials-list');
		const laudoBtn = document.getElementById('modal-laudo-btn');
		const manualBtn = document.getElementById('modal-manual-btn');

		const machinesData = window.__DELTAPAN_MACHINES__ || [];
		let is3dActive = false;
		let currentOpenMachine = null;

		// Configuração do decodificador meshopt para o model-viewer
		if (typeof window !== 'undefined' && window.customElements) {
			const setupMeshopt = () => {
				const MV = window.customElements.get('model-viewer');
				if (MV) {
					MV.meshoptDecoderLocation = '/models/meshopt_decoder.js';
				}
			};
			setupMeshopt();
			window.customElements.whenDefined('model-viewer').then(setupMeshopt);
		}

		function openModal(machineId) {
			const machine = machinesData.find(m => m.id === machineId) || machinesData[0];
			if (!machine) return;
			currentOpenMachine = machine;

			// Verifica se este produto possui modelo 3D (exclusivo da modeladora)
			const has3d = Boolean(machine.model3dUrl || machine.id === 'modeladora-esteira');

			// Botão "Ver em 3D" visível APENAS na modeladora
			if (btn3d) {
				btn3d.style.display = has3d ? 'inline-flex' : 'none';
			}

			// Reset 3D status e visualizadores para o padrão (Foto 2D)
			is3dActive = false;
			if (imageStage) imageStage.style.display = 'flex';
			if (model3dStage) model3dStage.style.display = 'none';
			if (imageBox) imageBox.classList.remove('active-3d-mode');
			if (notice3d) notice3d.classList.remove('active');
			if (btn3dText) btn3dText.textContent = 'Ver em 3D';
			if (modelViewer) {
				modelViewer.removeAttribute('src');
			}

			// Populate Data
			if (imgEl) {
				imgEl.src = machine.img?.src || machine.img;
				imgEl.alt = machine.alt || machine.name;
			}
			if (titleEl) titleEl.textContent = machine.name;
			if (modelEl) modelEl.textContent = machine.model;
			if (categoryEl) categoryEl.textContent = machine.category || 'Equipamento Industrial';
			if (descEl) descEl.textContent = machine.description || machine.shortDesc;

			// WhatsApp Link (+5548999274536)
			const whatsappPhone = '5548999274536';
			const defaultMessage = `Olá! Gostaria de solicitar um orçamento para o equipamento: ${machine.name} (${machine.model}).`;
			const encodedMessage = encodeURIComponent(machine.whatsappMsg || defaultMessage);
			if (whatsappCta) {
				whatsappCta.href = `https://wa.me/${whatsappPhone}?text=${encodedMessage}`;
			}

			// Specs Grid
			if (specsList) {
				specsList.innerHTML = '';
				if (machine.specs && machine.specs.length) {
					machine.specs.forEach(s => {
						const item = document.createElement('div');
						item.className = 'spec-chip';
						item.innerHTML = `
							<span class="chip-label">${s.label}</span>
							<span class="chip-val">${s.value}</span>
						`;
						specsList.appendChild(item);
					});
				}
			}

			// Differentials List
			if (diffList) {
				diffList.innerHTML = '';
				if (machine.differentials && machine.differentials.length) {
					machine.differentials.forEach(d => {
						const row = document.createElement('div');
						row.className = 'differential-item';
						row.innerHTML = `
							<div class="diff-bullet">
								<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
									<polyline points="20 6 9 17 4 12"></polyline>
								</svg>
							</div>
							<div class="diff-body">
								<strong class="diff-name">${d.title}</strong>
								<span class="diff-text">${d.desc}</span>
							</div>
						`;
						diffList.appendChild(row);
					});
				}
			}

			// Download Buttons
			const downloadHandler = (e, docType) => {
				e.preventDefault();
				alert(`O download do ${docType} da ${machine.name} (${machine.model}) será iniciado. Caso precise de suporte técnico imediato, fale conosco via WhatsApp!`);
			};

			if (laudoBtn) {
				laudoBtn.onclick = (e) => downloadHandler(e, 'Laudo Técnico NR-12');
			}
			if (manualBtn) {
				manualBtn.onclick = (e) => downloadHandler(e, 'Manual de Operação');
			}

			// Show Modal & Blur Body
			if (backdrop) {
				backdrop.classList.add('is-open');
				backdrop.setAttribute('aria-hidden', 'false');
			}
			document.body.classList.add('modal-open');
			document.documentElement.classList.add('modal-open');
		}

		function closeModal() {
			if (!backdrop) return;
			backdrop.classList.remove('is-open');
			backdrop.setAttribute('aria-hidden', 'true');
			document.body.classList.remove('modal-open');
			document.documentElement.classList.remove('modal-open');
			
			// Reset 3D
			is3dActive = false;
			if (imageStage) imageStage.style.display = 'flex';
			if (model3dStage) model3dStage.style.display = 'none';
			if (imageBox) imageBox.classList.remove('active-3d-mode');
			if (notice3d) notice3d.classList.remove('active');
			if (btn3dText) btn3dText.textContent = 'Ver em 3D';
			if (modelViewer) {
				modelViewer.removeAttribute('src');
			}
		}

		// Close events
		if (closeBtn) {
			closeBtn.addEventListener('click', closeModal);
		}

		if (backdrop) {
			backdrop.addEventListener('click', (e) => {
				if (e.target === backdrop) {
					closeModal();
				}
			});
		}

		document.addEventListener('keydown', (e) => {
			if (e.key === 'Escape' && backdrop && backdrop.classList.contains('is-open')) {
				closeModal();
			}
		});

		// 3D Preview Toggle
		if (btn3d) {
			btn3d.addEventListener('click', () => {
				if (!currentOpenMachine) return;
				const modelUrl = currentOpenMachine.model3dUrl || (currentOpenMachine.id === 'modeladora-esteira' ? '/models/modeladora.glb' : null);
				if (!modelUrl) return;

				is3dActive = !is3dActive;
				if (is3dActive) {
					if (imageStage) imageStage.style.display = 'none';
					if (model3dStage) model3dStage.style.display = 'flex';
					if (modelViewer) {
						if (modelViewer.getAttribute('src') !== modelUrl) {
							modelViewer.setAttribute('src', modelUrl);
						}
					}
					if (notice3d) notice3d.classList.add('active');
					if (btn3dText) btn3dText.textContent = 'Ver Foto 2D';
				} else {
					if (imageStage) imageStage.style.display = 'flex';
					if (model3dStage) model3dStage.style.display = 'none';
					if (notice3d) notice3d.classList.remove('active');
					if (btn3dText) btn3dText.textContent = 'Ver em 3D';
				}
			});
		}

		// Attach open modal listener to any element matching [data-open-modal]
		document.addEventListener('click', (e) => {
			const target = e.target.closest('[data-open-modal]');
			if (target) {
				const machineId = target.getAttribute('data-open-modal');
				if (machineId) {
					e.preventDefault();
					openModal(machineId);
				}
			}
		});
	});
</script>

